---
type ArtworkKey =
  | 'bazaar'
  | 'namakura'
  | 'taqi'
  | 'mielot'
  | 'hunters'
  | 'radar'
  | 'jamieson'
  | 'bosch'
  | 'kaguya';

interface Props {
  artwork: ArtworkKey;
  title: string;
  wide?: boolean;
}

const { artwork, title, wide = false } = Astro.props;

const artworks: Record<ArtworkKey, { src: string; alt: string; focus: string; tone: string }> = {
  bazaar: {
    src: 'https://commons.wikimedia.org/wiki/Special:FilePath/Marriage_Procession_in_a_Bazaar.jpg?width=1600',
    alt: 'Indian miniature painting of a crowded bazaar procession',
    focus: '50% 48%',
    tone: 'warm',
  },
  namakura: {
    src: 'https://commons.wikimedia.org/wiki/Special:FilePath/Anime_cell_1917.jpg?width=1600',
    alt: 'animation cel from the 1917 Japanese animated film Namakura Gatana',
    focus: '50% 52%',
    tone: 'ink',
  },
  taqi: {
    src: 'https://commons.wikimedia.org/wiki/Special:FilePath/Taqi_al_din.jpg?width=1600',
    alt: 'Ottoman miniature of Taqi al-Din and astronomers working in an observatory',
    focus: '50% 42%',
    tone: 'night',
  },
  mielot: {
    src: 'https://commons.wikimedia.org/wiki/Special:FilePath/Tavernier_Jean_Mielot.jpg?width=1600',
    alt: 'medieval manuscript painting of Jean Mielot writing in a scriptorium',
    focus: '48% 44%',
    tone: 'parchment',
  },
  hunters: {
    src: 'https://commons.wikimedia.org/wiki/Special:FilePath/Pieter_Bruegel_the_Elder_-_Hunters_in_the_Snow_(Winter)_-_Google_Art_Project.jpg?width=1600',
    alt: 'Pieter Bruegel the Elder painting Hunters in the Snow',
    focus: '52% 46%',
    tone: 'cold',
  },
  radar: {
    src: 'https://commons.wikimedia.org/wiki/Special:FilePath/Izmit_interferogram.jpg?width=1600',
    alt: 'synthetic aperture radar interferogram showing surface deformation patterns',
    focus: '50% 50%',
    tone: 'signal',
  },
  jamieson: {
    src: 'https://commons.wikimedia.org/wiki/Special:FilePath/Alexander_Jamieson_Celestial_Atlas-Contents.jpg?width=1600',
    alt: 'celestial atlas plate with zodiac figures and astronomical diagrams',
    focus: '50% 46%',
    tone: 'blue',
  },
  bosch: {
    src: 'https://commons.wikimedia.org/wiki/Special:FilePath/The_Garden_of_Earthly_Delights_by_Bosch_High_Resolution.jpg?width=1600',
    alt: 'Hieronymus Bosch triptych The Garden of Earthly Delights',
    focus: '50% 50%',
    tone: 'strange',
  },
  kaguya: {
    src: 'https://commons.wikimedia.org/wiki/Special:FilePath/Mira_calligraphiae_monumenta_(Model_Book_of_Calligraphy)_Joris_Hoefnagel_1596_Ms.20_(86.MV.527)_fol._133_guide_for_constructing_the_letter_g_(enhanced_image_by_Rawpixel).jpg?width=1600',
    alt: 'ornamental calligraphy page from Mira calligraphiae monumenta',
    focus: '50% 50%',
    tone: 'folio',
  },
};

const selected = artworks[artwork];
---

<figure
  class:list={['project-art', `project-art--${selected.tone}`, { 'project-art--wide': wide }]}
  style={`--focus: ${selected.focus}`}
>
  <img src={selected.src} alt={`${title}: ${selected.alt}`} loading="eager" decoding="async" />
</figure>

<style>
  .project-art {
    position: relative;
    aspect-ratio: 5 / 3;
    overflow: hidden;
    background: var(--surface-void);
    border-radius: var(--radius-card) var(--radius-card) 0 0;
    isolation: isolate;
  }

  .project-art--wide {
    aspect-ratio: 21 / 7;
  }

  .project-art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--focus);
    transform: scale(1.015);
    filter: saturate(0.78) contrast(1.08) brightness(0.82);
    transition: transform var(--duration-cinematic) var(--ease-out),
                filter var(--duration-cinematic) var(--ease-out);
  }

  .project-art::before,
  .project-art::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
  }

  .project-art::before {
    background:
      radial-gradient(circle at 50% 42%, transparent 0 38%, rgba(0, 0, 0, 0.5) 100%),
      linear-gradient(to bottom, rgba(17, 17, 16, 0.04), rgba(17, 17, 16, 0.38));
  }

  .project-art::after {
    opacity: 0.13;
    mix-blend-mode: overlay;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='c'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23c)'/%3E%3C/svg%3E");
    background-size: 180px 180px;
  }

  :global(.project-card:hover) .project-art img,
  :global(.project-featured:hover) .project-art img,
  :global(.work-card:hover) .project-art img {
    transform: scale(1.055);
    filter: saturate(0.96) contrast(1.12) brightness(0.9);
  }

  .project-art--warm img { filter: saturate(0.9) contrast(1.08) brightness(0.84); }
  .project-art--ink img { filter: saturate(0.35) contrast(1.22) brightness(0.78); }
  .project-art--night img { filter: saturate(0.85) contrast(1.12) brightness(0.75); }
  .project-art--parchment img { filter: saturate(0.72) contrast(1.04) brightness(0.86); }
  .project-art--cold img { filter: saturate(0.62) contrast(1.1) brightness(0.82); }
  .project-art--signal img { filter: saturate(1.05) contrast(1.16) brightness(0.78); }
  .project-art--blue img { filter: saturate(0.76) contrast(1.12) brightness(0.78); }
  .project-art--strange img { filter: saturate(0.82) contrast(1.1) brightness(0.78); }
  .project-art--folio img { filter: saturate(0.7) contrast(1.08) brightness(0.86); }

  @media (max-width: 768px) {
    .project-art--wide {
      aspect-ratio: 5 / 3;
    }
  }
</style>
