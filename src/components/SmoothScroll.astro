---
/** Lightweight Lenis scroll + hero image fade into chalk field */
---

<script>
  import Lenis from 'lenis';

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const root = document.documentElement;
  const heroVisual = document.querySelector('[data-hero-visual]');
  const hero = document.querySelector('[data-hero]');
  const heroImg = document.querySelector('[data-hero-img]');

  const updateHeroFade = (scrollY = window.scrollY) => {
    if (!heroVisual || !hero) return;

    if (reduceMotion) {
      root.style.setProperty('--hero-fade', '0');
      return;
    }

    const range = Math.max(hero.offsetHeight * 0.9, window.innerHeight * 0.6);
    const progress = Math.min(Math.max(scrollY / range, 0), 1);
    const faded = 1 - (1 - progress) * (1 - progress);
    root.style.setProperty('--hero-fade', (1 - faded).toFixed(4));
  };

  updateHeroFade();

  if (!reduceMotion) {
    const isGecko = CSS.supports('-moz-appearance', 'none');

    const lenis = new Lenis({
      autoRaf: true,
      lerp: isGecko ? 0.16 : 0.12,
      smoothWheel: true,
      syncTouch: false,
      touchMultiplier: 1.4,
      wheelMultiplier: isGecko ? 0.85 : 1,
    });

    document.documentElement.classList.add('lenis', 'lenis-smooth');

    let scrolling = false;
    let idleTimer = 0;
    let rafQueued = false;

    const setScrolling = (active) => {
      if (scrolling === active) return;
      scrolling = active;
      document.documentElement.toggleAttribute('data-scrolling', active);
    };

    lenis.on('scroll', ({ scroll, velocity }) => {
      const moving = Math.abs(velocity) > 0.08;
      if (moving) {
        setScrolling(true);
        window.clearTimeout(idleTimer);
        idleTimer = window.setTimeout(() => setScrolling(false), 120);
      }

      if (!rafQueued) {
        rafQueued = true;
        requestAnimationFrame(() => {
          rafQueued = false;
          updateHeroFade(scroll);
        });
      }
    });

    document.addEventListener(
      'visibilitychange',
      () => {
        if (document.hidden) lenis.stop();
        else lenis.start();
      },
      { passive: true },
    );

    window.addEventListener('resize', () => updateHeroFade(lenis.scroll), { passive: true });
  } else {
    window.addEventListener('scroll', () => updateHeroFade(), { passive: true });
  }
</script>
