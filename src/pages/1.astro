---
import Base from '../layouts/Base.astro';
import VariantNav from '../components/VariantNav.astro';
import ProjectArtwork from '../components/ProjectArtwork.astro';
import { profile, facts, skills, selectedWork } from '../data/site';
---

<Base title="Home · 1" class="v1">
  <VariantNav kind="landing" current="1" />

  <!-- ═══ MASTHEAD ═══ -->
  <section class="v1__mast">
    <div class="container v1__mastgrid">
      <div class="v1__id">
        <span class="v1__index">№ 01 — Index</span>
        <h1 class="v1__name">
          <span>{profile.first}</span>
          <span class="v1__last">{profile.last}<i class="v1__dot">.</i></span>
        </h1>
        <p class="v1__role">{profile.role}</p>
      </div>

      <aside class="v1__rail">
        <div class="v1__railrow v1__railrow--head">
          <span>Field notes</span>
          <span class="v1__live"><i></i> live</span>
        </div>
        {facts.map((f) => (
          <div class="v1__railrow">
            <span class="v1__rl">{f.label}</span>
            <span class="v1__rv">{f.value}</span>
          </div>
        ))}
        <a class="v1__mail" href={`mailto:${profile.email}`}>{profile.email} →</a>
      </aside>
    </div>

    <div class="container v1__strip">
      <p class="v1__tagline">{profile.tagline}</p>
      <div class="v1__cta">
        <a href="/work" class="btn-pill">View Work <span class="arrow">→</span></a>
        <a href="/journal" class="btn-ghost">Journal</a>
      </div>
    </div>
  </section>

  <!-- ═══ PULL QUOTE ═══ -->
  <section class="container v1__quote" data-reveal>
    <span class="v1__qmark">“</span>
    <p>{profile.quote}</p>
  </section>

  <!-- ═══ STACK ═══ -->
  <section class="container v1__stack">
    <div class="v1__sec" data-reveal>
      <span class="section-label">02 — Stack</span>
    </div>
    <div class="v1__chips" data-reveal style="--stagger:1">
      {skills.map((s) => <span class="tag">{s}</span>)}
    </div>
  </section>

  <!-- ═══ WORK ROWS ═══ -->
  <section class="container v1__work">
    <div class="v1__sec" data-reveal>
      <span class="section-label">03 — Selected Work</span>
      <h2 class="v1__sectitle">Beyond the Terminal.</h2>
    </div>

    {selectedWork.map((p, i) => (
      <a class="v1__row" href={p.href} data-reveal style={`--stagger:${i + 1}`}>
        <span class="v1__rownum">0{i + 1}</span>
        <div class="v1__rowart">
          <ProjectArtwork artwork={p.artwork} title={p.title} />
        </div>
        <div class="v1__rowbody">
          <div class="v1__rowtags">
            {p.tags.map((t, ti) => (
              <span class:list={['tag', { 'tag--accent': i === 0 && ti === 0, 'tag--cold': i !== 0 && ti === 0 }]}>{t}</span>
            ))}
          </div>
          <h3 class="v1__rowtitle">{p.title}</h3>
          <p class="v1__rowdesc">{p.description}</p>
        </div>
        <span class="v1__rowarrow">→</span>
      </a>
    ))}
  </section>
</Base>

<style>
  .v1__mast { padding: 128px 0 var(--space-12); border-bottom: 1px solid var(--border-subtle); }
  .v1__mastgrid {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: var(--space-16);
    align-items: end;
  }
  .v1__index {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--text-label-ls);
    text-transform: uppercase;
    color: var(--accent-primary);
  }
  .v1__name {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(64px, 12vw, 168px);
    line-height: 0.88;
    letter-spacing: -0.035em;
    color: var(--text-primary);
    margin: var(--space-4) 0 var(--space-6);
  }
  .v1__name span { display: block; }
  .v1__last { font-style: italic; }
  .v1__dot { color: var(--accent-primary); font-style: normal; }
  .v1__role {
    font-family: var(--font-display);
    font-size: clamp(20px, 2.4vw, 30px);
    line-height: 1.3;
    color: var(--text-secondary);
    max-width: 30ch;
  }

  .v1__rail {
    display: flex;
    flex-direction: column;
    border-left: 1px solid var(--border-default);
    padding-left: var(--space-6);
    gap: var(--space-3);
  }
  .v1__railrow { display: flex; flex-direction: column; gap: 2px; padding: var(--space-2) 0; border-bottom: 1px dashed var(--border-subtle); }
  .v1__railrow--head {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--text-label-ls);
    text-transform: uppercase;
    color: var(--text-ghost);
  }
  .v1__live { display: inline-flex; align-items: center; gap: 6px; color: var(--accent-sage); }
  .v1__live i { width: 6px; height: 6px; border-radius: 50%; background: var(--accent-sage); animation: pulse-dot 2s ease-in-out infinite; }
  .v1__rl {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--text-label-ls);
    text-transform: uppercase;
    color: var(--text-ghost);
  }
  .v1__rv { font-size: var(--text-body-sm); color: var(--text-secondary); }
  .v1__mail {
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-body-sm);
    color: var(--accent-cold);
    text-decoration: none;
  }
  .v1__mail:hover { color: var(--accent-cold-hover); }

  .v1__strip {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-10);
    margin-top: var(--space-20);
  }
  .v1__tagline { max-width: 56ch; font-size: var(--text-body-lg); line-height: 1.6; color: var(--text-tertiary); }
  .v1__cta { display: flex; gap: var(--space-3); flex-shrink: 0; }

  .v1__quote {
    position: relative;
    padding: var(--space-24) var(--space-16);
    max-width: 920px;
  }
  .v1__qmark {
    position: absolute;
    top: 40px;
    left: 0;
    font-family: var(--font-display);
    font-size: 96px;
    color: var(--accent-primary);
    opacity: 0.5;
  }
  .v1__quote p {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(26px, 3.4vw, 44px);
    line-height: 1.3;
    color: var(--text-primary);
    max-width: 24ch;
  }

  .v1__stack { padding: var(--space-12) 0 var(--space-16); }
  .v1__chips { display: flex; flex-wrap: wrap; gap: var(--space-2); }

  .v1__work { padding-bottom: var(--space-24); }
  .v1__sec { margin-bottom: var(--space-10); }
  .v1__sectitle {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: var(--text-h2);
    color: var(--text-primary);
    margin-top: var(--space-2);
  }

  .v1__row {
    display: grid;
    grid-template-columns: 56px 220px 1fr 32px;
    gap: var(--space-8);
    align-items: center;
    padding: var(--space-6) 0;
    border-top: 1px solid var(--border-subtle);
    text-decoration: none;
    transition: padding var(--duration-slow) var(--ease-out), background var(--duration-base) var(--ease-out);
  }
  .v1__row:last-child { border-bottom: 1px solid var(--border-subtle); }
  .v1__row:hover { padding-left: var(--space-4); padding-right: var(--space-4); background: var(--surface-raised); }
  .v1__rownum { font-family: var(--font-mono); font-size: var(--text-body-sm); color: var(--text-ghost); }
  .v1__rowart { width: 220px; border-radius: var(--radius-md); overflow: hidden; }
  .v1__rowart :global(.project-art) { border-radius: 0; aspect-ratio: 16 / 10; }
  .v1__rowbody { display: flex; flex-direction: column; gap: var(--space-3); }
  .v1__rowtags { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .v1__rowtitle { font-family: var(--font-display); font-weight: 400; font-size: var(--text-h3); color: var(--text-primary); }
  .v1__rowdesc { font-size: var(--text-body-sm); color: var(--text-tertiary); max-width: 60ch; }
  .v1__rowarrow { font-family: var(--font-display); font-size: 28px; color: var(--text-ghost); transition: transform var(--duration-slow) var(--ease-out), color var(--duration-base) var(--ease-out); }
  .v1__row:hover .v1__rowarrow { transform: translateX(8px); color: var(--accent-primary); }

  @media (max-width: 900px) {
    .v1__mastgrid { grid-template-columns: 1fr; gap: var(--space-10); }
    .v1__rail { border-left: none; border-top: 1px solid var(--border-default); padding-left: 0; padding-top: var(--space-5); }
    .v1__strip { flex-direction: column; align-items: flex-start; }
    .v1__row { grid-template-columns: 1fr; gap: var(--space-4); }
    .v1__rowart { width: 100%; }
    .v1__rowarrow { display: none; }
  }
</style>
