---
import Base from '../layouts/Base.astro';
import VariantNav from '../components/VariantNav.astro';
import ProjectArtwork from '../components/ProjectArtwork.astro';
import { profile, facts, skills, selectedWork } from '../data/site';
---

<Base title="Home · 2" class="v2">
  <VariantNav kind="landing" current="2" />

  <section class="v2">
    <div class="container v2__grid">

      <!-- name cell -->
      <article class="bento bento--name" data-reveal>
        <span class="bento__tag">whoami</span>
        <h1 class="bento__name">{profile.first}<br/><i>{profile.last}</i></h1>
        <p class="bento__role">{profile.role}</p>
      </article>

      <!-- status cell -->
      <article class="bento bento--status" data-reveal style="--stagger:1">
        <span class="bento__tag">status</span>
        <p class="bento__statustext"><span class="dot"></span> Open to research & backend roles</p>
        <p class="bento__loc">{profile.location}</p>
      </article>

      <!-- tagline cell -->
      <article class="bento bento--tag" data-reveal style="--stagger:2">
        <span class="bento__tag">about</span>
        <p class="bento__tagtext">{profile.tagline}</p>
      </article>

      <!-- CTA cell -->
      <article class="bento bento--cta" data-reveal style="--stagger:3">
        <a href="/work" class="bento__cta">View Work →</a>
        <a href={`mailto:${profile.email}`} class="bento__ctaghost">Get in touch</a>
      </article>

      <!-- skills cell -->
      <article class="bento bento--skills" data-reveal style="--stagger:4">
        <span class="bento__tag">stack · {skills.length}</span>
        <div class="bento__chips">
          {skills.map((s) => <span class="tag">{s}</span>)}
        </div>
      </article>

      <!-- work cells -->
      {selectedWork.map((p, i) => (
        <a
          href={p.href}
          class:list={['bento', `bento--work${i + 1}`]}
          data-reveal
          style={`--stagger:${5 + i}`}
        >
          <div class="bento__cover"><ProjectArtwork artwork={p.artwork} title={p.title} /></div>
          <div class="bento__workbody">
            <div class="bento__worktags">
              {p.tags.slice(0, 2).map((t, ti) => (
                <span class:list={['tag', { 'tag--accent': i === 0 && ti === 0, 'tag--cold': i !== 0 && ti === 0 }]}>{t}</span>
              ))}
            </div>
            <h3 class="bento__worktitle">{p.title}</h3>
            <p class="bento__workdesc">{p.description}</p>
          </div>
        </a>
      ))}

      <!-- quote cell -->
      <article class="bento bento--quote" data-reveal style="--stagger:8">
        <span class="v1__qmark">“</span>
        <p>{profile.quote}</p>
      </article>

      <!-- now cell -->
      <article class="bento bento--now" data-reveal style="--stagger:9">
        <span class="bento__tag">now</span>
        <dl class="bento__facts">
          {facts.slice(0, 3).map((f) => (
            <div><dt>{f.label}</dt><dd>{f.value}</dd></div>
          ))}
        </dl>
      </article>

    </div>
  </section>
</Base>

<style>
  .v2 { padding: 116px 0 var(--space-16); }
  .v2__grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-auto-rows: minmax(120px, auto);
    gap: var(--space-4);
  }

  .bento {
    position: relative;
    background: var(--surface-raised);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: border-color var(--duration-base) var(--ease-out),
                transform var(--duration-slow) var(--ease-out);
  }
  .bento:hover { border-color: var(--border-strong); }

  .bento__tag {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--text-label-ls);
    text-transform: uppercase;
    color: var(--text-ghost);
    margin-bottom: auto;
  }

  /* placements */
  .bento--name { grid-column: span 4; grid-row: span 2; justify-content: flex-end; gap: var(--space-3); background: var(--surface-dim); }
  .bento--status { grid-column: span 2; grid-row: span 1; justify-content: space-between; }
  .bento--tag { grid-column: span 2; grid-row: span 1; justify-content: flex-end; }
  .bento--cta { grid-column: span 4; grid-row: span 1; flex-direction: row; align-items: center; justify-content: flex-end; gap: var(--space-3); }
  .bento--skills { grid-column: span 3; grid-row: span 2; }
  .bento--work1 { grid-column: span 3; grid-row: span 3; padding: 0; text-decoration: none; }
  .bento--work2 { grid-column: span 3; grid-row: span 2; padding: 0; text-decoration: none; }
  .bento--work3 { grid-column: span 3; grid-row: span 2; padding: 0; text-decoration: none; }
  .bento--quote { grid-column: span 4; grid-row: span 1; justify-content: center; }
  .bento--now { grid-column: span 2; grid-row: span 1; }

  /* name cell */
  .bento__name {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(56px, 9vw, 120px);
    line-height: 0.9;
    letter-spacing: -0.03em;
    color: var(--text-primary);
  }
  .bento__name i { font-style: italic; color: var(--accent-amber); }
  .bento__role { font-size: var(--text-body-lg); color: var(--text-tertiary); }

  /* status */
  .dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--accent-sage); animation: pulse-dot 2s ease-in-out infinite; margin-right: 8px; }
  .bento__statustext { font-size: var(--text-body); color: var(--text-primary); }
  .bento__loc { font-family: var(--font-mono); font-size: var(--text-caption); letter-spacing: var(--text-caption-ls); color: var(--text-ghost); }

  .bento__tagtext { font-size: var(--text-body); color: var(--text-secondary); line-height: 1.6; }

  /* cta */
  .bento__cta {
    font-family: var(--font-mono); font-size: var(--text-label); letter-spacing: var(--text-label-ls); text-transform: uppercase;
    color: var(--surface-base); background: var(--text-primary); padding: var(--space-3) var(--space-5); border-radius: var(--radius-pill); text-decoration: none;
  }
  .bento__ctaghost {
    font-family: var(--font-mono); font-size: var(--text-label); letter-spacing: var(--text-label-ls); text-transform: uppercase;
    color: var(--text-secondary); border: 1px solid var(--border-strong); padding: var(--space-3) var(--space-5); border-radius: var(--radius-pill); text-decoration: none;
  }

  /* skills */
  .bento__chips { display: flex; flex-wrap: wrap; gap: var(--space-2); content-visibility: auto; }

  /* work */
  .bento__cover { flex: 1; min-height: 0; }
  .bento__cover :global(.project-art) { border-radius: 0; height: 100%; aspect-ratio: auto; }
  .bento--work1 .bento__cover { aspect-ratio: 16/9; }
  .bento--work2 .bento__cover, .bento--work3 .bento__cover { aspect-ratio: 16/8; }
  .bento__workbody { padding: var(--space-5) var(--space-6); display: flex; flex-direction: column; gap: var(--space-2); }
  .bento__worktags { display: flex; gap: var(--space-2); }
  .bento__worktitle { font-family: var(--font-display); font-weight: 400; font-size: var(--text-h4); color: var(--text-primary); }
  .bento__workdesc { font-size: var(--text-body-sm); color: var(--text-tertiary); line-height: 1.5; }
  .bento--work1:hover, .bento--work2:hover, .bento--work3:hover { transform: translateY(-4px); }

  /* quote */
  .v1__qmark { font-family: var(--font-display); font-size: 40px; color: var(--accent-primary); margin-right: var(--space-2); }
  .bento--quote p { font-family: var(--font-display); font-style: italic; font-size: var(--text-h4); color: var(--text-primary); }

  /* now */
  .bento__facts { display: flex; flex-direction: column; gap: var(--space-2); margin-top: auto; }
  .bento__facts div { display: flex; flex-direction: column; gap: 2px; }
  .bento__facts dt { font-family: var(--font-mono); font-size: 10px; letter-spacing: var(--text-label-ls); text-transform: uppercase; color: var(--text-ghost); }
  .bento__facts dd { font-size: var(--text-body-sm); color: var(--text-secondary); }

  @media (max-width: 900px) {
    .v2__grid { grid-template-columns: repeat(2, 1fr); }
    .bento--name, .bento--cta, .bento--skills, .bento--work1, .bento--work2, .bento--work3, .bento--quote { grid-column: span 2; }
    .bento--status, .bento--tag, .bento--now { grid-column: span 2; }
    .bento--work1, .bento--work2, .bento--work3 { grid-row: span 1; }
  }
  @media (max-width: 520px) {
    .v2__grid { grid-template-columns: 1fr; }
    .bento--name, .bento--status, .bento--tag, .bento--cta, .bento--skills, .bento--work1, .bento--work2, .bento--work3, .bento--quote, .bento--now { grid-column: span 1; }
    .bento--cta { flex-direction: column; align-items: stretch; }
  }
</style>
