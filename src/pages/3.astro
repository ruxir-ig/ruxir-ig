---
import Base from '../layouts/Base.astro';
import VariantNav from '../components/VariantNav.astro';
import ProjectArtwork from '../components/ProjectArtwork.astro';
import { profile, facts, skills, featuredProject, projects, experience, education } from '../data/site';

const focus = [
  { k: '01', t: 'Backend', d: 'APIs, job orchestration, billing guardrails, and the unglamorous plumbing that keeps systems honest.' },
  { k: '02', t: 'ML Infrastructure', d: 'Inference runtimes, model lifecycle, GPU serving paths, and packaging models for real use.' },
  { k: '03', t: 'AI Research', d: 'Leaning deeper — retrieval, agents, observability, and the ideas behind the tooling I build.' },
];

// master + detail list: featured first, then the rest
const all = [featuredProject, ...projects];
// masonry-ish rhythm of tile sizes (organized, not random)
const sizes = ['feat', 'wide', 'wide', 'wide', 'tall', 'wide', 'wide', 'tall', 'wide'];
---

<Base title="Home · 3" class="v3">
  <VariantNav kind="landing" current="3" />

  <main class="v3">
    <div class="v3__inner">

      <header class="v3__head">
        <span class="v3__mark">RK</span>
        <span class="v3__rule"></span>
        <span class="v3__meta">{profile.location} — est. 2026</span>
      </header>

      <!-- HERO -->
      <section class="v3__hero">
        <p class="v3__kicker">Backend engineer, leaning into research.</p>
        <h1 class="v3__statement">
          I build the systems<br/>
          behind the interface<span class="v3__period">.</span>
        </h1>
        <p class="v3__lede">{profile.tagline}</p>
      </section>

      <hr class="v3__hr"/>

      <!-- ABOUT -->
      <section class="v3__about">
        <div class="v3__aboutlabel"><span class="v3__num">01</span><span>About</span></div>
        <p class="v3__aboutbody">{profile.bio}</p>
      </section>

      <hr class="v3__hr"/>

      <!-- FOCUS -->
      <section class="v3__focus">
        <div class="v3__aboutlabel"><span class="v3__num">02</span><span>Focus</span></div>
        <div class="v3__focusgrid">
          {focus.map((f) => (
            <div class="v3__focuscell">
              <span class="v3__focusk">{f.k}</span>
              <h3 class="v3__focust">{f.t}</h3>
              <p class="v3__focusd">{f.d}</p>
            </div>
          ))}
        </div>
      </section>

      <hr class="v3__hr"/>

      <!-- STACK -->
      <section class="v3__stack">
        <div class="v3__aboutlabel"><span class="v3__num">03</span><span>Stack · {skills.length}</span></div>
        <ul class="v3__skills">
          {skills.map((s) => <li>{s}</li>)}
        </ul>
      </section>

      <hr class="v3__hr"/>

      <!-- LUNCHBOX -->
      <section class="v3__lunchwrap">
        <div class="v3__aboutlabel"><span class="v3__num">04</span><span>Work</span></div>
        <a href="/work" class="v3__lunch" data-lunchbox aria-label="Open work bento">
          <span class="v3__lunchsvg" aria-hidden="true">
            <svg viewBox="0 0 160 104" xmlns="http://www.w3.org/2000/svg">
              <rect class="lb-shell" x="3" y="20" width="154" height="80" rx="10"/>
              <rect class="lb-lid"  x="3" y="14" width="154" height="12" rx="6"/>
              <rect class="lb-clasp" x="70" y="9" width="20" height="8" rx="3"/>
              <g class="lb-comps">
                <rect class="lb-c lb-c1" x="10" y="30" width="86" height="34" rx="5"/>
                <rect class="lb-c lb-c2" x="102" y="30" width="48" height="34" rx="5"/>
                <rect class="lb-c lb-c3" x="10" y="70" width="44" height="24" rx="5"/>
                <rect class="lb-c lb-c4" x="60" y="70" width="44" height="24" rx="5"/>
                <rect class="lb-c lb-c5" x="110" y="70" width="40" height="24" rx="5"/>
              </g>
            </svg>
          </span>
          <span class="v3__lunchbody">
            <span class="v3__lunchtitle">Open the lunchbox</span>
            <span class="v3__lunchhint">{all.length} projects inside — click to zoom in <span class="v3__luncharrow">↗</span></span>
          </span>
        </a>
      </section>

      <hr class="v3__hr"/>

      <!-- CONTACT -->
      <section class="v3__sign">
        <div class="v3__aboutlabel"><span class="v3__num">05</span><span>Contact</span></div>
        <div class="v3__contactgrid">
          <a class="v3__contact" href={`mailto:${profile.email}`}>
            <span class="v3__cl">email</span>
            <span class="v3__cv">{profile.email} <i>→</i></span>
          </a>
          <a class="v3__contact" href={profile.github} target="_blank" rel="noopener">
            <span class="v3__cl">github</span>
            <span class="v3__cv">@ruxir-ig <i>→</i></span>
          </a>
          <a class="v3__contact" href={profile.linkedin} target="_blank" rel="noopener">
            <span class="v3__cl">linkedin</span>
            <span class="v3__cv">in/ruchirkalokhe <i>→</i></span>
          </a>
          <div class="v3__contact">
            <span class="v3__cl">status</span>
            <span class="v3__cv"><span class="v3__sdot"></span>{facts[5].value}</span>
          </div>
        </div>
        <p class="v3__copy">© 2026 {profile.name} — {profile.location}</p>
      </section>

    </div>
  </main>

  <!-- ═════════════════════════════════════════════════════════════════
       LUNCHBOX OVERLAY
       · opens with a transform/opacity zoom (stable in Firefox)
       · grid = bento (organized) × gallery (image-forward, hover captions)
       · every tile opens a case-study detail (master ↔ detail)
       ═════════════════════════════════════════════════════════════════ -->
  <div class="bx" data-bento aria-hidden="true">
    <div class="bx__scrim" data-close></div>

    <div class="bx__panel" data-panel>
      <header class="bx__head">
        <div class="bx__headtxt">
          <span class="bx__label" data-head-label>The lunchbox — open</span>
          <h2 class="bx__title" data-head-title>Selected <i>Work.</i></h2>
        </div>
        <button class="bx__close" data-close aria-label="Close">
          <svg viewBox="0 0 24 24" width="20" height="20"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        </button>
      </header>

      <!-- GRID STATE -->
      <div class="bx__grid" data-grid>
        {all.map((p, i) => (
          <button
            type="button"
            class:list={['bt', `bt--${sizes[i] ?? 'std'}`]}
            data-open={i}
            style={`--ci:${i}`}
          >
            <div class="bt__art"><ProjectArtwork artwork={p.artwork} title={p.title} /></div>
            <span class="bt__shade"></span>
            <span class="bt__cap">
              <span class="bt__tags">
                {p.tags.slice(0, 2).map((t, ti) => (
                  <span class:list={['tag', { 'tag--accent': i === 0 && ti === 0, 'tag--cold': i !== 0 && ti === 0 }]}>{t}</span>
                ))}
              </span>
              <span class="bt__title">{p.title}</span>
              <span class="bt__desc">{p.description}</span>
              <span class="bt__open">Open case study <i>↗</i></span>
            </span>
            {i === 0 && <span class="bt__featflag">Featured</span>}
          </button>
        ))}

        <!-- static context tiles -->
        <article class="bt bt--info bt--wide">
          <span class="bt__infok">Experience</span>
          <span class="bt__infot">{experience.company}</span>
          <span class="bt__infod">{experience.role} · {experience.range}</span>
          <span class="bt__infotags">{experience.tags.map((t) => <span class="tag">{t}</span>)}</span>
        </article>
        <article class="bt bt--info bt--wide">
          <span class="bt__infok">Education</span>
          <span class="bt__infot">{education.school}</span>
          <span class="bt__infod">{education.degree}</span>
          <span class="bt__infod">{education.date}</span>
        </article>
      </div>

      <!-- DETAIL STATE (one case-study per project, pre-rendered) -->
      <div class="bx__details" data-details>
        {all.map((p, i) => (
          <article class="cs" data-detail={i}>
            <div class="cs__topbar">
              <button class="cs__back" data-back type="button">← Back to grid</button>
              <div class="cs__pos" aria-label={`Project ${i + 1} of ${all.length}`}>
                <span>{String(i + 1).padStart(2, '0')}</span><i>/</i><span>{String(all.length).padStart(2, '0')}</span>
              </div>
            </div>
            <div class="cs__body">
              <aside class="cs__meta">
                <div class="cs__metarow"><span class="cs__ml">Type</span><span class="cs__mv">{p.type ?? 'Project'}</span></div>
                <div class="cs__metarow"><span class="cs__ml">Status</span><span class="cs__mv"><i class="cs__dot"></i>{p.status ?? '—'}</span></div>
                <div class="cs__metarow"><span class="cs__ml">Year</span><span class="cs__mv">{p.year ?? '—'}</span></div>
                <div class="cs__metarow"><span class="cs__ml">Stack</span><span class="cs__mv">{p.tags.join(' · ')}</span></div>
                <div class="cs__links">
                  <a href={p.href} target="_blank" rel="noopener">Source ↗</a>
                  {p.liveHref && <a href={p.liveHref} target="_blank" rel="noopener">Live ↗</a>}
                </div>
              </aside>
              <div class="cs__prose">
                <div class="cs__tags">
                  {p.tags.map((t, ti) => <span class:list={['tag', { 'tag--accent': i === 0 && ti === 0, 'tag--cold': i !== 0 && ti === 0 }]}>{t}</span>)}
                </div>
                <h3 class="cs__title">{p.title}</h3>
                <p class="cs__sub">{p.subtitle ?? p.description}</p>
                <p class="cs__lead">{p.description}</p>
                {p.details && (
                  <ul class="cs__details">
                    {p.details.map((d) => <li>{d}</li>)}
                  </ul>
                )}
              </div>
            </div>

            <nav class="cs__sibs" aria-label="Project navigation">
              <button class="cs__sib cs__sib--prev" data-prev type="button">
                <span class="cs__sibkey">‹</span>
                <span class="cs__sibname">{all[(i - 1 + all.length) % all.length].title}</span>
              </button>
              <button class="cs__sib cs__sib--next" data-next type="button">
                <span class="cs__sibkey">›</span>
                <span class="cs__sibname">{all[(i + 1) % all.length].title}</span>
              </button>
            </nav>
          </article>
        ))}
      </div>
    </div>
  </div>
</Base>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const EASE = 'cubic-bezier(0.16, 1, 0.3, 1)';
  const EASE_OUT_QUICK = 'cubic-bezier(0.33, 1, 0.68, 1)';

  const trigger = document.querySelector<HTMLElement>('[data-lunchbox]');
  const overlay = document.querySelector<HTMLElement>('[data-bento]');
  const panel = document.querySelector<HTMLElement>('[data-panel]');
  const grid = document.querySelector<HTMLElement>('[data-grid]');
  const details = document.querySelector<HTMLElement>('[data-details]');
  const tiles = Array.from(document.querySelectorAll<HTMLElement>('[data-open]'));
  const detailBlocks = Array.from(document.querySelectorAll<HTMLElement>('[data-detail]'));
  const headTitle = document.querySelector<HTMLElement>('[data-head-title]');
  const headLabel = document.querySelector<HTMLElement>('[data-head-label]');

  let running: Animation[] = [];
  let navBusy = false;
  const kill = () => { running.forEach((a) => a.cancel()); running = []; };
  const anim = (el: Element, kf: Keyframe[], opt: KeyframeAnimationOptions) => {
    const a = (el as Element).animate(kf, opt); running.push(a); return a;
  };

  const origin = () => {
    if (!trigger) return 'center';
    const r = trigger.getBoundingClientRect();
    return `${r.left + r.width / 2}px ${r.top + r.height / 2}px`;
  };

  function showGridOnly() {
    overlay?.classList.remove('is-detail');
    detailBlocks.forEach((d) => d.classList.remove('is-active'));
  }

  function open() {
    if (!overlay || !panel || !grid) return;
    navBusy = false;
    showGridOnly();
    overlay.classList.add('is-open');
    overlay.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    panel.style.transformOrigin = origin();
    kill();

    if (reduce) {
      panel.style.opacity = '1'; panel.style.transform = 'none';
      grid.style.opacity = '1';
      tiles.forEach((t) => (t.style.opacity = '1'));
      return;
    }
    panel.style.opacity = '0';
    anim(panel, [{ opacity: 0, transform: 'scale(0.06)' }, { opacity: 1, transform: 'scale(1)' }],
      { duration: 600, easing: EASE, fill: 'forwards' });
    const scrim = overlay.querySelector('.bx__scrim');
    anim(scrim!, [{ opacity: 0 }, { opacity: 1 }], { duration: 280, easing: 'ease', fill: 'forwards' });
    tiles.forEach((t, i) => {
      t.style.opacity = '0';
      anim(t, [{ opacity: 0, transform: 'translateY(22px) scale(0.97)' }, { opacity: 1, transform: 'none' }],
        { duration: 440, delay: 220 + i * 45, easing: EASE, fill: 'forwards' });
    });
    // info tiles animate with the rest
    document.querySelectorAll<HTMLElement>('.bx__grid .bt--info').forEach((t, i) => {
      t.style.opacity = '0';
      anim(t, [{ opacity: 0, transform: 'translateY(22px)' }, { opacity: 1, transform: 'none' }],
        { duration: 440, delay: 220 + (tiles.length + i) * 45, easing: EASE, fill: 'forwards' });
    });
  }

  function close() {
    if (!overlay || !panel || !overlay.classList.contains('is-open')) return;
    navBusy = false;
    panel.style.transformOrigin = origin();
    kill();
    document.body.style.overflow = '';
    if (reduce) { overlay.classList.remove('is-open'); overlay.setAttribute('aria-hidden', 'true'); showGridOnly(); return; }
    const pa = anim(panel, [{ opacity: 1, transform: 'scale(1)' }, { opacity: 0, transform: 'scale(0.06)' }],
      { duration: 380, easing: 'cubic-bezier(0.5, 0, 0.75, 0)', fill: 'forwards' });
    pa.onfinish = () => {
      overlay.classList.remove('is-open');
      overlay.setAttribute('aria-hidden', 'true');
      showGridOnly();
      panel.style.opacity = '0';
      grid.style.opacity = '1';
    };
  }

  function activeDetail() {
    return details?.querySelector<HTMLElement>('.cs.is-active') ?? null;
  }

  function openDetail(i: string) {
    if (!overlay || !grid || !details || !panel) return;
    if (overlay.classList.contains('is-detail')) return;
    if (reduce) {
      overlay.classList.add('is-detail');
      detailBlocks.forEach((d) => d.classList.toggle('is-active', d.dataset.detail === i));
      panel.scrollTo({ top: 0 });
      return;
    }
    const out = anim(grid, [{ opacity: 1, transform: 'none' }, { opacity: 0, transform: 'scale(0.985)' }],
      { duration: 180, easing: 'ease', fill: 'forwards' });
    out.onfinish = () => {
      overlay.classList.add('is-detail');
      detailBlocks.forEach((d) => d.classList.toggle('is-active', d.dataset.detail === i));
      panel.scrollTo({ top: 0 });
      const block = activeDetail();
      if (block) anim(block, [{ opacity: 0, transform: 'translateY(16px)' }, { opacity: 1, transform: 'none' }],
        { duration: 360, delay: 30, easing: EASE, fill: 'forwards' });
    };
  }

  function backToGrid() {
    if (!overlay || !grid || !panel) return;
    if (!overlay.classList.contains('is-detail')) return;
    navBusy = false;
    if (reduce) { showGridOnly(); grid.style.opacity = '1'; return; }
    const block = activeDetail();
    const fin = block
      ? anim(block, [{ opacity: 1 }, { opacity: 0 }], { duration: 160, easing: 'ease', fill: 'forwards' })
      : null;
    const done = () => {
      showGridOnly();
      anim(grid, [{ opacity: 0, transform: 'scale(1.012)' }, { opacity: 1, transform: 'none' }],
        { duration: 300, easing: EASE_OUT_QUICK, fill: 'forwards' });
    };
    if (fin) fin.onfinish = done; else done();
  }

  function currentIdx() {
    const a = activeDetail();
    return a ? Number(a.dataset.detail) : 0;
  }

  function goTo(target: number, dir: number) {
    if (!details || !panel || !overlay) return;
    if (navBusy || !overlay.classList.contains('is-detail')) return;
    const N = detailBlocks.length;
    const idx = ((target % N) + N) % N;
    const old = activeDetail();
    if (old && Number(old.dataset.detail) === idx) return;
    const neu = detailBlocks[idx];
    const sign = dir >= 0 ? 1 : -1;

    if (reduce) {
      detailBlocks.forEach((d) => d.classList.toggle('is-active', d === neu));
      panel.scrollTo({ top: 0 });
      return;
    }

    navBusy = true;
    const done = () => {
      if (old) old.classList.remove('is-active');
      neu.classList.add('is-active');
      panel.scrollTo({ top: 0 });
      anim(neu, [{ opacity: 0, transform: `translateX(${sign * 48}px)` }, { opacity: 1, transform: 'none' }],
        { duration: 340, easing: EASE, fill: 'forwards' });
      navBusy = false;
    };
    if (old) {
      const out = anim(old, [{ opacity: 1, transform: 'none' }, { opacity: 0, transform: `translateX(${-sign * 48}px)` }],
        { duration: 190, easing: 'ease', fill: 'forwards' });
      out.onfinish = done;
    } else {
      done();
    }
  }

  trigger?.addEventListener('click', (e) => { e.preventDefault(); open(); });
  overlay?.querySelectorAll('[data-close]').forEach((b) => b.addEventListener('click', close));
  tiles.forEach((t) => t.addEventListener('click', () => openDetail(t.dataset.open ?? '0')));
  details?.querySelectorAll('[data-back]').forEach((b) => b.addEventListener('click', backToGrid));
  details?.querySelectorAll('[data-prev]').forEach((b) => b.addEventListener('click', () => goTo(currentIdx() - 1, -1)));
  details?.querySelectorAll('[data-next]').forEach((b) => b.addEventListener('click', () => goTo(currentIdx() + 1, 1)));

  const PREV_KEYS = new Set(['a', 'h', 'k', 'arrowleft']);
  const NEXT_KEYS = new Set(['d', 'l', 'j', 'arrowright']);
  document.addEventListener('keydown', (e) => {
    const k = e.key.toLowerCase();
    if (k === 'escape') {
      if (overlay?.classList.contains('is-detail')) backToGrid();
      else close();
      return;
    }
    if (!overlay?.classList.contains('is-detail')) return;
    if (PREV_KEYS.has(k)) { e.preventDefault(); goTo(currentIdx() - 1, -1); }
    else if (NEXT_KEYS.has(k)) { e.preventDefault(); goTo(currentIdx() + 1, 1); }
  });
</script>

<style>
  /* ═══ PAGE (SWISS) ═══ */
  .v3 { min-height: 100vh; padding: 132px var(--gutter) var(--space-24); }
  .v3__inner { width: 100%; max-width: 720px; margin: 0 auto; }

  .v3__head { display: flex; align-items: center; gap: var(--space-4); margin-bottom: var(--space-24); }
  .v3__mark { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.2em; color: var(--text-primary); border: 1px solid var(--border-strong); border-radius: 50%; width: 30px; height: 30px; display: inline-grid; place-items: center; }
  .v3__rule { flex: 1; height: 1px; background: var(--border-subtle); }
  .v3__meta { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-ghost); }

  .v3__hero { margin-bottom: var(--space-16); }
  .v3__kicker { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent-primary); margin-bottom: var(--space-8); }
  .v3__statement { font-family: var(--font-display); font-weight: 400; font-size: clamp(40px, 6.5vw, 76px); line-height: 1.02; letter-spacing: -0.025em; color: var(--text-primary); margin-bottom: var(--space-10); }
  .v3__period { color: var(--accent-primary); }
  .v3__lede { font-size: var(--text-body-lg); line-height: 1.7; color: var(--text-tertiary); max-width: 56ch; }

  .v3__hr { border: none; height: 1px; background: var(--border-subtle); margin: var(--space-16) 0; }

  .v3__aboutlabel { display: flex; align-items: baseline; gap: var(--space-4); margin-bottom: var(--space-6); font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-ghost); }
  .v3__num { color: var(--accent-primary); }
  .v3__aboutbody { font-size: var(--text-body-lg); line-height: 1.75; color: var(--text-secondary); max-width: 60ch; }

  .v3__focusgrid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-8); }
  .v3__focuscell { display: flex; flex-direction: column; gap: var(--space-2); }
  .v3__focusk { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.16em; color: var(--text-ghost); }
  .v3__focust { font-family: var(--font-display); font-size: var(--text-h4); color: var(--text-primary); }
  .v3__focusd { font-size: var(--text-body-sm); line-height: 1.6; color: var(--text-tertiary); }

  .v3__skills { list-style: none; display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-3); }
  .v3__skills li { font-family: var(--font-mono); font-size: var(--text-body-sm); color: var(--text-secondary); }
  .v3__skills li::before { content: '/ '; color: var(--text-ghost); }

  /* LUNCHBOX */
  .v3__lunchwrap { display: flex; flex-direction: column; }
  .v3__lunch {
    display: flex; align-items: center; gap: var(--space-6);
    padding: var(--space-8);
    border: 1px solid var(--border-default); border-radius: var(--radius-lg);
    background: var(--surface-raised);
    text-decoration: none;
    transition: border-color var(--duration-base) var(--ease-out), transform var(--duration-slow) var(--ease-out), box-shadow var(--duration-slow) var(--ease-out);
  }
  .v3__lunch:hover { border-color: var(--accent-primary); transform: translateY(-3px); box-shadow: var(--shadow-lg); }
  .v3__lunchsvg { flex-shrink: 0; width: 132px; }
  .v3__lunchsvg svg { width: 100%; height: auto; display: block; }
  .v3__lunchsvg .lb-shell, .v3__lunchsvg .lb-lid { fill: none; stroke: var(--border-strong); stroke-width: 1.5; transition: stroke var(--duration-base) var(--ease-out); }
  .v3__lunchsvg .lb-clasp { fill: var(--surface-glare); stroke: var(--border-strong); stroke-width: 1.5; }
  .v3__lunchsvg .lb-c { fill: var(--surface-dim); stroke: var(--border-subtle); stroke-width: 1.2; transition: fill var(--duration-base) var(--ease-out), stroke var(--duration-base) var(--ease-out); }
  .v3__lunch:hover .lb-shell, .v3__lunch:hover .lb-lid { stroke: var(--accent-primary); }
