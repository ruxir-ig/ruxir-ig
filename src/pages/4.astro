---
import Base from '../layouts/Base.astro';
import VariantNav from '../components/VariantNav.astro';
import ProjectArtwork from '../components/ProjectArtwork.astro';
import { profile, facts, skills, selectedWork } from '../data/site';
const _quote = profile.quote;
---

<Base title="Home · 4" class="v5">
  <VariantNav kind="landing" current="4" />

  <!-- ═══ FULL-BLEED HERO ═══ -->
  <section class="v5__hero mesh-field">
    <div class="v5__heroveil"></div>
    <div class="v5__heroframe">
      <span class="v5__reel">REEL 01 — RUCHIR KALOKHE</span>
      <h1 class="v5__title">
        <span>Engineer</span>
        <span class="v5__ital">of the unseen</span>
        <span>systems<span class="v5__dot">.</span></span>
      </h1>
      <div class="v5__herobottom">
        <p class="v5__herorole">{profile.role}</p>
        <a href="#work" class="v5__scroll">scroll <span class="v5__scrollline"></span></a>
      </div>
    </div>
  </section>

  <!-- ═══ MARQUEE STRIP ═══ -->
  <div class="v5__marquee" aria-hidden="true">
    <div class="v5__track">
      {['Backend', 'ML Infra', 'AI Research', 'Developer Tooling', 'Systems', 'Backend', 'ML Infra', 'AI Research', 'Developer Tooling', 'Systems'].map((w) => (
        <span class="v5__mw">{w}<i>✦</i></span>
      ))}
    </div>
  </div>

  <!-- ═══ INTRO ═══ -->
  <section class="container v5__intro">
    <div class="v5__introgrid">
      <span class="v5__chap">Ch. 01 — Intent</span>
      <p class="v5__statement" data-reveal>{profile.tagline}</p>
      <p class="v5__bio" data-reveal style="--stagger:1">{profile.bio}</p>
    </div>
  </section>

  <!-- ═══ FACTS BAND ═══ -->
  <section class="container v5__facts">
    {facts.map((f, i) => (
      <div class="v5__fact" data-reveal style={`--stagger:${i}`}>
        <span class="v5__fl">{f.label}</span>
        <span class="v5__fv">{f.value}</span>
      </div>
    ))}
  </section>

  <!-- ═══ QUOTE SLAB ═══ -->
  <section class="v5__slab" data-reveal>
    <div class="container">
      <p class="v5__q">“{_quote}”</p>
      <span class="v5__qsig">— {profile.name}</span>
    </div>
  </section>

  <!-- ═══ WORK ═══ -->
  <section class="container v5__work" id="work">
    <div class="v5__workhead" data-reveal>
      <span class="v5__chap">Ch. 02 — Selected Work</span>
      <h2 class="v5__worktitle">Beyond the<br/><i>Terminal.</i></h2>
    </div>

    {selectedWork.map((p, i) => (
      <a class:list={['v5__feat', { 'v5__feat--flip': i % 2 === 1 }]} href={p.href} data-reveal style={`--stagger:${i + 1}`}>
        <div class="v5__featart"><ProjectArtwork artwork={p.artwork} title={p.title} wide /></div>
        <div class="v5__featbody">
          <span class="v5__featnum">— 0{i + 1}</span>
          <div class="v5__feattags">
            {p.tags.map((t, ti) => (
              <span class:list={['tag', { 'tag--accent': i === 0 && ti === 0, 'tag--cold': i !== 0 && ti === 0 }]}>{t}</span>
            ))}
          </div>
          <h3 class="v5__feattitle">{p.title}</h3>
          <p class="v5__featdesc">{p.description}</p>
          <span class="v5__featgo">View project →</span>
        </div>
      </a>
    ))}
  </section>

  <!-- ═══ STACK FOOTER ═══ -->
  <section class="container v5__stack">
    <span class="v5__chap" data-reveal>Ch. 03 — Stack</span>
    <div class="v5__skills" data-reveal style="--stagger:1">
      {skills.map((s) => <span class="v5__skill">{s}</span>)}
    </div>
  </section>
</Base>

<style>
  .v5__hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: flex-end;
    padding: 120px var(--gutter) var(--space-12);
    overflow: hidden;
  }
  .v5__heroveil {
    position: absolute; inset: 0;
    background: radial-gradient(ellipse at 50% 60%, transparent 20%, rgba(8,8,8,0.7) 95%);
  }
  .v5__heroframe { position: relative; width: 100%; max-width: var(--container-wide); margin: 0 auto; }
  .v5__reel {
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.3em; text-transform: uppercase; color: var(--accent-primary);
    display: inline-flex; align-items: center; gap: 10px;
  }
  .v5__title {
    font-family: var(--font-display); font-weight: 400;
    font-size: clamp(64px, 14vw, 220px);
    line-height: 0.86; letter-spacing: -0.04em;
    color: var(--text-primary);
    margin: var(--space-6) 0 var(--space-12);
  }
  .v5__title span { display: block; }
  .v5__ital { font-style: italic; color: var(--accent-amber); padding-left: 12vw; }
  .v5__dot { color: var(--accent-primary); }
  .v5__herobottom { display: flex; justify-content: space-between; align-items: flex-end; gap: var(--space-8); border-top: 1px solid rgba(240,237,232,0.12); padding-top: var(--space-6); }
  .v5__herorole { font-family: var(--font-display); font-style: italic; font-size: clamp(20px, 2.4vw, 32px); color: var(--text-secondary); max-width: 40ch; }
  .v5__scroll { display: inline-flex; align-items: center; gap: var(--space-3); font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--text-tertiary); text-decoration: none; }
  .v5__scrollline { width: 40px; height: 1px; background: var(--text-tertiary); display: inline-block; }

  /* marquee */
  .v5__marquee { overflow: hidden; border-top: 1px solid var(--border-subtle); border-bottom: 1px solid var(--border-subtle); padding: var(--space-5) 0; background: var(--surface-dim); }
  .v5__track { display: flex; gap: var(--space-8); white-space: nowrap; animation: v5scroll 28s linear infinite; }
  .v5__mw { font-family: var(--font-display); font-style: italic; font-size: var(--text-h2); color: var(--text-primary); display: inline-flex; align-items: center; gap: var(--space-8); }
  .v5__mw i { color: var(--accent-primary); font-style: normal; font-size: 16px; }
  @keyframes v5scroll { to { transform: translateX(-50%); } }

  /* intro */
  .v5__intro { padding: var(--space-40) 0; }
  .v5__introgrid { display: grid; grid-template-columns: 200px 1.4fr 1fr; gap: var(--space-12); align-items: start; }
  .v5__chap { font-family: var(--font-mono); font-size: var(--text-label); letter-spacing: var(--text-label-ls); text-transform: uppercase; color: var(--accent-primary); }
  .v5__statement { font-family: var(--font-display); font-weight: 400; font-size: clamp(28px, 3.6vw, 48px); line-height: 1.25; color: var(--text-primary); }
  .v5__bio { font-size: var(--text-body-lg); line-height: 1.7; color: var(--text-tertiary); }

  /* facts */
  .v5__facts { display: grid; grid-template-columns: repeat(6, 1fr); border-top: 1px solid var(--border-subtle); border-bottom: 1px solid var(--border-subtle); }
  .v5__fact { display: flex; flex-direction: column; gap: 6px; padding: var(--space-8) var(--space-5); border-right: 1px solid var(--border-subtle); }
  .v5__fact:last-child { border-right: none; }
  .v5__fl { font-family: var(--font-mono); font-size: 10px; letter-spacing: var(--text-label-ls); text-transform: uppercase; color: var(--text-ghost); }
  .v5__fv { font-family: var(--font-display); font-size: var(--text-body); color: var(--text-primary); line-height: 1.3; }

  /* slab */
  .v5__slab { padding: var(--space-40) 0; background: var(--surface-dim); border-top: 1px solid var(--border-subtle); border-bottom: 1px solid var(--border-subtle); }
  .v5__q { font-family: var(--font-display); font-style: italic; font-weight: 400; font-size: clamp(36px, 6vw, 88px); line-height: 1.08; letter-spacing: -0.02em; color: var(--text-primary); max-width: 18ch; }
  .v5__qsig { display: block; margin-top: var(--space-8); font-family: var(--font-mono); font-size: var(--text-label); letter-spacing: var(--text-label-ls); text-transform: uppercase; color: var(--text-ghost); }

  /* work */
  .v5__work { padding: var(--space-40) 0; }
  .v5__workhead { margin-bottom: var(--space-24); }
  .v5__worktitle { font-family: var(--font-display); font-weight: 400; font-size: clamp(48px, 8vw, 120px); line-height: 0.9; letter-spacing: -0.03em; color: var(--text-primary); margin-top: var(--space-4); }
  .v5__worktitle i { color: var(--accent-amber); }
  .v5__feat { display: grid; grid-template-columns: 1.4fr 1fr; gap: var(--space-12); align-items: center; padding: var(--space-16) 0; border-top: 1px solid var(--border-subtle); text-decoration: none; }
  .v5__feat--flip { grid-template-columns: 1fr 1.4fr; }
  .v5__feat--flip .v5__featart { order: 2; }
  .v5__featart :global(.project-art) { border-radius: var(--radius-lg); }
  .v5__featbody { display: flex; flex-direction: column; gap: var(--space-4); }
  .v5__featnum { font-family: var(--font-mono); font-size: var(--text-caption); letter-spacing: var(--text-caption-ls); color: var(--accent-primary); }
  .v5__feattags { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .v5__feattitle { font-family: var(--font-display); font-weight: 400; font-size: clamp(32px, 4vw, 56px); line-height: 1; color: var(--text-primary); }
  .v5__featdesc { font-size: var(--text-body-lg); line-height: 1.6; color: var(--text-tertiary); max-width: 50ch; }
  .v5__featgo { font-family: var(--font-mono); font-size: var(--text-label); letter-spacing: var(--text-label-ls); text-transform: uppercase; color: var(--accent-cold); margin-top: var(--space-2); }

  /* stack */
  .v5__stack { padding-bottom: var(--space-24); }
  .v5__skills { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-8); }
  .v5__skill {
    font-family: var(--font-mono); font-size: var(--text-body-sm);
    color: var(--text-secondary); border: 1px solid var(--border-default);
    padding: var(--space-3) var(--space-5); border-radius: var(--radius-pill);
    background: var(--surface-raised);
    transition: border-color var(--duration-base) var(--ease-out), color var(--duration-base) var(--ease-out);
  }
  .v5__skill:hover { border-color: var(--accent-primary); color: var(--accent-primary); }

  @media (max-width: 900px) {
    .v5__introgrid { grid-template-columns: 1fr; gap: var(--space-6); }
    .v5__facts { grid-template-columns: repeat(2, 1fr); }
    .v5__fact { border-bottom: 1px solid var(--border-subtle); }
    .v5__feat, .v5__feat--flip { grid-template-columns: 1fr; }
    .v5__feat--flip .v5__featart { order: 0; }
  }
</style>
