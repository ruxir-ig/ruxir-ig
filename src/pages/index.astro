---
import Base from '../layouts/Base.astro';
import { Atmosphere } from '../components/Atmosphere';
import { FloatControls } from '../components/FloatControls';
import { HeroLinks } from '../components/HeroLinks';
import { profile, projects, thoughts } from '../data/site';
import '../styles/site.css';
---

<Base>
  <div class="site-shell">
    <div class="site-shader">
      <Atmosphere client:load />
    </div>

    <div class="hero-visual" data-hero-visual aria-hidden="true">
      <img
        class="hero-visual__img"
        data-hero-img
        src="/visuals/hero-coast.jpg"
        alt=""
        width="1024"
        height="574"
        decoding="async"
        fetchpriority="high"
      />
      <div class="hero-visual__veil"></div>
    </div>

    <div class="site-content">
      <FloatControls client:load />

      <main class="page">
        <section class="hero" id="about" data-hero>
          <p class="meta" data-reveal>Pune · Open to opportunities</p>
          <h1 class="display" data-reveal>
            {profile.first}
            <br />
            <span class="serif-italic">{profile.last}</span>
          </h1>
          <p class="hero__role" data-reveal>{profile.role}</p>
          <p class="hero__bio lede" data-reveal>{profile.bio}</p>
          <HeroLinks client:visible profile={profile} />
        </section>

        <section class="section" id="work">
          <h2 class="section-label">Projects</h2>
          <div class="work-list">
            {
              projects.map((project) => (
                <a
                  class="work-item pressable"
                  href={project.liveHref ?? project.href}
                  data-shader={project.shader}
                  rel="noopener noreferrer"
                  target="_blank"
                >
                  <span class="work-item__title">{project.title}</span>
                  <span class="work-item__desc">{project.subtitle}</span>
                </a>
              ))
            }
          </div>
        </section>

        <section class="section" id="notes">
          <h2 class="section-label">Notes</h2>
          <div class="notes-list">
            {
              thoughts.map((note) => (
                <article class="note">
                  <h3 class="note__title">{note.title}</h3>
                  <p class="note__excerpt">{note.excerpt}</p>
                </article>
              ))
            }
          </div>
        </section>
      </main>

      <footer class="site-footer" id="contact">
        <div class="site-footer__art" aria-hidden="true">
          <img
            src="/visuals/footer-sunset.jpg"
            alt=""
            width="1024"
            height="576"
            loading="lazy"
            decoding="async"
          />
          <div class="site-footer__art-veil"></div>
        </div>
        <div class="page site-footer__inner">
          <div class="site-footer__sign" aria-hidden="true">
            <svg viewBox="0 0 650 200" width="180" height="52">
              <path
                d="M 238 40 L 418 40 L 223 160 L 373 100 L 478 40 L 238 40 L 493 100 L 73 100 L 553 100 L 538 40 L 493 100 L 373 100 L 178 40"
                stroke="currentColor"
                stroke-width="3"
                fill="none"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </div>
          <div class="site-footer__contact">
            <a href={`mailto:${profile.email}`}>{profile.email}</a>
            <a href={profile.github} rel="noopener noreferrer" target="_blank">github.com/ruxir-ig</a>
          </div>
        </div>
      </footer>
    </div>
  </div>
</Base>
