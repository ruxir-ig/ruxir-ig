---
import Base from '../layouts/Base.astro';
import { Atmosphere } from '../components/Atmosphere';
import { HeroLinks } from '../components/HeroLinks';
import { ProjectsList } from '../components/ProjectsList';
import { experience, profile, projects, thoughts } from '../data/site';
import '../styles/site.css';
---

<Base>
  <script is:inline>
    (function () {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      document.documentElement.dataset.nameMotion = fine ? 'drag' : 'touch';
    })();
  </script>
  <div class="site-shell">
    <div class="site-shader">
      <Atmosphere client:load />
    </div>

    <div class="hero-visual" data-hero-visual aria-hidden="true">
      <img
        class="hero-visual__img"
        data-hero-img
        src="/visuals/hero-coast.jpg"
        alt=""
        width="1024"
        height="574"
        decoding="async"
        fetchpriority="high"
      />
      <div class="hero-visual__veil"></div>
    </div>

    <div class="site-content">
      <main class="page">
        <section class="hero" id="about" data-hero>
          <p class="meta" data-reveal>Pune · Open to opportunities</p>
          <h1 class="display name-intro" data-name-intro aria-label={`${profile.first} ${profile.last}`}>
            <span class="name-intro__word name-intro__word--first">
              <span class="name-intro__motion">
                {
                  profile.first.split('').map((letter) => (
                    <span class="name-intro__letter">{letter}</span>
                  ))
                }
              </span>
            </span>
            <span class="name-intro__word name-intro__word--last serif-italic">
              <span class="name-intro__motion">
                {
                  profile.last.split('').map((letter) => (
                    <span class="name-intro__letter">{letter}</span>
                  ))
                }
              </span>
            </span>
          </h1>
          <p class="hero__role" data-reveal>{profile.role}</p>
          <HeroLinks client:visible profile={profile} />
        </section>

        <section class="section" id="work">
          <h2 class="section-label">Projects</h2>
          <ProjectsList client:load projects={projects} />
        </section>

        <section class="section" id="experience">
          <h2 class="section-label">Experience</h2>
          <div class="experience-list">
            {
              experience.map((role) => (
                <article class="experience">
                  <div class="experience__meta">
                    <h3 class="experience__org">
                      {role.orgHref ? (
                        <a href={role.orgHref} target="_blank" rel="noopener noreferrer">
                          {role.org}
                        </a>
                      ) : (
                        role.org
                      )}
                    </h3>
                    <p class="experience__period">{role.period}</p>
                  </div>
                  <div class="experience__detail">
                    <p class="experience__title">{role.title}</p>
                    <p class="experience__summary">{role.summary}</p>
                  </div>
                </article>
              ))
            }
          </div>
        </section>

        <section class="section" id="notes">
          <h2 class="section-label">Notes</h2>
          <div class="notes-list">
            {
              thoughts.map((note) => (
                <article class="note">
                  <h3 class="note__title">{note.title}</h3>
                  <p class="note__excerpt">{note.excerpt}</p>
                </article>
              ))
            }
          </div>
        </section>
      </main>

      <footer class="site-footer" id="contact">
        <div class="site-footer__art" aria-hidden="true">
          <img
            src="/visuals/footer-sunset.jpg"
            alt=""
            width="1024"
            height="576"
            loading="lazy"
            decoding="async"
          />
          <div class="site-footer__art-veil"></div>
        </div>
        <div class="page site-footer__inner">
          <div class="site-footer__sign" aria-hidden="true">
            <svg viewBox="0 0 650 200" width="180" height="52">
              <path
                d="M 238 40 L 418 40 L 223 160 L 373 100 L 478 40 L 238 40 L 493 100 L 73 100 L 553 100 L 538 40 L 493 100 L 373 100 L 178 40"
                stroke="currentColor"
                stroke-width="3"
                fill="none"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </div>
          <div class="site-footer__contact">
            <a href={`mailto:${profile.email}`}>{profile.email}</a>
            <a href={profile.github} rel="noopener noreferrer" target="_blank">github.com/ruxir-ig</a>
          </div>
        </div>
      </footer>
    </div>
  </div>
  <script>
    import { bootNameIntro } from '../scripts/name-intro';

    bootNameIntro();
  </script>
</Base>
