---
import Base from '../layouts/Base.astro';
import { Atmosphere } from '../components/Atmosphere';
import { nav, now, profile, projects, thoughts } from '../data/site';
import '../styles/site.css';

const featured = projects.filter((p) => p.featured);
const rest = projects.filter((p) => !p.featured);
---

<Base>
  <div class="site-shell">
    <div class="site-shader">
      <Atmosphere client:load />
    </div>

    <div class="hero-visual" data-hero-visual aria-hidden="true">
      <img
        class="hero-visual__img"
        data-hero-img
        src="/visuals/hero-coast.jpg"
        alt=""
        width="1024"
        height="574"
        decoding="async"
        fetchpriority="high"
      />
      <div class="hero-visual__veil"></div>
    </div>

    <div class="site-content">
      <header class="site-nav">
        <div class="rail site-nav__inner">
          <a class="site-nav__brand pressable" href="#about">ruchir.dev</a>
          <nav aria-label="Primary">
            <ul class="site-nav__links">
              {
                nav.map((item) => (
                  <li>
                    <a href={item.href}>{item.label}</a>
                  </li>
                ))
              }
            </ul>
          </nav>
          <div class="site-nav__actions">
            <button
              type="button"
              class="site-nav__theme pressable"
              data-theme-toggle
              aria-label="Toggle light and dark theme"
              title="Toggle theme"
            >
              <span data-theme-label aria-hidden="true"></span>
            </button>
            <a class="site-nav__cta pressable" href={profile.resume}>
              Resume
              <span class="site-nav__cta-icon" aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </header>

      <main>
        <section class="rail hero" id="about" data-hero>
          <p class="meta" data-reveal>Pune · Open to opportunities</p>
          <div class="hero__grid">
            <div>
              <h1 class="display" data-reveal>
                {profile.first}
                <br />
                <span class="serif-italic">{profile.last}</span>
              </h1>
              <p class="hero__role" data-reveal>{profile.role}</p>
              <p class="hero__bio lede" data-reveal>{profile.bio}</p>
              <div class="hero__links" data-reveal>
                <a href={`mailto:${profile.email}`}>Email</a>
                <a href={profile.github} rel="noopener noreferrer" target="_blank">GitHub</a>
                <a href={profile.linkedin} rel="noopener noreferrer" target="_blank">LinkedIn</a>
                <a href={profile.resume}>Resume PDF</a>
              </div>
            </div>
            <dl class="hero__meta" data-reveal>
              <div>
                <dt>Now</dt>
                <dd>{now.role}</dd>
                <dd>{now.company}</dd>
              </div>
              <div>
                <dt>Focus</dt>
                <dd>Backend · ML infra · Research</dd>
              </div>
              <div>
                <dt>Currently</dt>
                <dd>{now.summary}</dd>
              </div>
            </dl>
          </div>
        </section>

        <section class="rail section" id="work">
          <div class="section__head">
            <p class="section__kicker">Selected work</p>
            <h2 class="section-title">Projects that earn a closer look</h2>
          </div>

          <div class="work-list">
            {
              featured.map((project) => (
                <a
                  class="work-item work-item--featured pressable"
                  href={project.liveHref ?? project.href}
                  data-shader={project.shader}
                  rel="noopener noreferrer"
                  target="_blank"
                >
                  <div>
                    <h3 class="work-item__title">{project.title}</h3>
                    <p class="work-item__subtitle">{project.subtitle}</p>
                    <p class="work-item__desc">{project.description}</p>
                    <ul class="work-item__highlights">
                      {project.highlights.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                    <ul class="work-item__tags">
                      {project.tags.map((tag) => (
                        <li>{tag}</li>
                      ))}
                    </ul>
                  </div>
                  <span class="work-item__side">
                    <span class="work-item__year">{project.year}</span>
                    {project.liveHref && <span class="work-item__live">live ↗</span>}
                  </span>
                </a>
              ))
            }
            {
              rest.map((project) => (
                <a
                  class="work-item pressable"
                  href={project.liveHref ?? project.href}
                  data-shader={project.shader}
                  rel="noopener noreferrer"
                  target="_blank"
                >
                  <div>
                    <h3 class="work-item__title">{project.title}</h3>
                    <p class="work-item__subtitle">{project.subtitle}</p>
                    <p class="work-item__desc">{project.description}</p>
                    <ul class="work-item__tags">
                      {project.tags.map((tag) => (
                        <li>{tag}</li>
                      ))}
                    </ul>
                  </div>
                  <span class="work-item__side">
                    <span class="work-item__year">{project.year}</span>
                    {project.liveHref && <span class="work-item__live">live ↗</span>}
                  </span>
                </a>
              ))
            }
          </div>
        </section>

        <section class="rail section" id="notes">
          <div class="section__head">
            <p class="section__kicker">Notes</p>
            <h2 class="section-title">Short thoughts worth keeping open</h2>
            <p class="lede">Brief notes from shipping systems that sit between ML, backends, and tooling.</p>
          </div>
          <div class="notes-grid">
            {
              thoughts.map((note) => (
                <article class="note">
                  <p class="meta">{note.date}</p>
                  <h3 class="note__title">{note.title}</h3>
                  <p class="note__excerpt">{note.excerpt}</p>
                </article>
              ))
            }
          </div>
        </section>
      </main>

      <footer class="site-footer" id="contact">
        <div class="site-footer__art" aria-hidden="true">
          <img
            src="/visuals/footer-sunset.jpg"
            alt=""
            width="1024"
            height="576"
            loading="lazy"
            decoding="async"
          />
          <div class="site-footer__art-veil"></div>
        </div>
        <div class="rail site-footer__inner">
          <div>
            <button
              type="button"
              class="site-footer__sign-btn pressable"
              data-theme-toggle
              aria-label="Toggle light and dark theme"
              title="Toggle theme"
            >
              <svg
                class="site-footer__sign"
                viewBox="0 0 650 200"
                width="220"
                height="60"
                aria-hidden="true"
              >
                <path
                  d="M 238 40 L 418 40 L 223 160 L 373 100 L 478 40 L 238 40 L 493 100 L 73 100 L 553 100 L 538 40 L 493 100 L 373 100 L 178 40"
                  stroke="currentColor"
                  stroke-width="3"
                  fill="none"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </button>
          </div>
          <div class="site-footer__contact">
            <a href={`mailto:${profile.email}`}>{profile.email}</a>
            <a href={profile.github} rel="noopener noreferrer" target="_blank">github.com/ruxir-ig</a>
          </div>
        </div>
      </footer>
    </div>
  </div>
</Base>
