---
import Base from '../layouts/Base.astro';
import ProjectArtwork from '../components/ProjectArtwork.astro';

const featuredProject = {
  title: 'mccia-tracelink',
  subtitle: 'Supply-chain traceability platform',
  href: 'https://github.com/ruxir-ig/mccia-tracelink',
  liveHref: 'https://mccia-tracelink.onrender.com/',
  artwork: 'bazaar' as const,
  tags: ['TypeScript', 'Traceability', 'Graph flows'],
  type: 'Full-stack platform',
  status: 'Active development',
  details: [
    'Factory-floor supply-chain tracing built from the current MCCIA TraceLink repository.',
    'Models contaminated-batch propagation, incomplete records, and operational handoffs across the chain.',
    'Uses a public-domain Indian bazaar procession reference to match the chain-of-custody and movement theme.',
  ],
};

const projects = [
  {
    title: 'candis',
    href: 'https://github.com/ruxir-ig/candis',
    artwork: 'namakura' as const,
    tags: ['Python', 'Recruiting AI'],
    description: 'Intelligent candidate discovery tooling for search, scoring, and shortlisting workflows.',
  },
  {
    title: 'auscult',
    href: 'https://github.com/ruxir-ig/auscult',
    artwork: 'taqi' as const,
    tags: ['Python', 'Healthcare AI', 'Observability'],
    description: 'Passive observability layer for healthcare AI agents, shaped around monitoring rather than chat UI.',
  },
  {
    title: 'personal-memory-engine',
    href: 'https://github.com/ruxir-ig/personal-memory-engine',
    artwork: 'mielot' as const,
    tags: ['TypeScript', 'Memory', 'Local-first'],
    description: 'A local-first memory engine for capturing, structuring, and revisiting personal context.',
  },
  {
    title: 'nitch',
    href: 'https://github.com/ruxir-ig/nitch',
    artwork: 'hunters' as const,
    tags: ['Nim', 'Linux', 'System fetch'],
    description: 'Incredibly fast system-fetch tooling in Nim, maintained for Linux-first workflows.',
  },
  {
    title: 'SAR Image Colorization',
    href: 'https://github.com/ruxir-ig/SAR-Image-Colorization',
    artwork: 'radar' as const,
    tags: ['PyTorch', 'GANs', 'Remote sensing'],
    description: 'GAN-based SAR image colorization that turns grayscale radar imagery into RGB terrain reconstructions.',
  },
  {
    title: 'QKD_sim',
    href: 'https://github.com/ruxir-ig/QKD_sim',
    liveHref: 'https://qkd-sim.vercel.app',
    artwork: 'jamieson' as const,
    tags: ['TypeScript', 'Quantum', 'BB84'],
    description: 'A browser simulator for the BB84 quantum key distribution protocol, with a deployed interactive build.',
  },
  {
    title: 'MuseTalk API',
    href: 'https://github.com/ruxir-ig/MuseTalk-API',
    artwork: 'kaguya' as const,
    tags: ['Python', 'GPU inference', 'Lip sync'],
    description: 'REST API wrapper around MuseTalk for real-time talking-head generation and inference experiments.',
  },
  {
    title: 'clawrrency',
    href: 'https://github.com/ruxir-ig/clawrrency',
    artwork: 'bosch' as const,
    tags: ['TypeScript', 'AI agents', 'Currency'],
    description: 'A cooperative digital currency system for AI bots, exploring agent incentives and exchange.',
  },
];
---

<Base title="Work" description="Career timeline, projects, and technical explorations.">

  <section class="page-header section">
    <div class="container">
      <div class="breadcrumb hero-animate" style="--delay: 0">
        <a href="/">Home</a>
        <span class="breadcrumb__sep">/</span>
        <span>Work</span>
      </div>
      <h1 class="page-title hero-animate" style="--delay: 1">Career &<br/>Projects</h1>
      <p class="page-subtitle hero-animate" style="--delay: 2">
        A curated timeline of professional experience, technical explorations,
        and open-source contributions.
      </p>
    </div>
  </section>


  <!-- ═══ EXPERIENCE ═══ -->
  <section class="section">
    <div class="container">
      <div data-reveal>
        <span class="section-label">01 — Experience</span>
        <h2 class="section-title">Where I've Been.</h2>
      </div>

      <div class="timeline" data-reveal style="--stagger: 1">
        <div class="timeline-entry">
          <div class="timeline-date">
            <span class="date-range">Dec 2025 — May 2026</span>
            <span class="date-location">Remote</span>
          </div>
          <div class="timeline-line">
            <div class="timeline-dot"></div>
          </div>
          <div class="timeline-content">
            <h3 class="timeline-company">In2peta Services Pvt. Ltd.</h3>
            <p class="timeline-role">Gen AI Intern — Backend & ML Infrastructure</p>
            <ul class="timeline-list">
              <li>Built backend and inference infrastructure for the GPU model platform using TypeScript, Fastify, PostgreSQL, Redis, Prisma, BullMQ, and Docker</li>
              <li>Implemented job orchestration, model lifecycle flows, runtime packaging, API workflows, and model-serving paths</li>
              <li>Worked across Docker builds, runtime configuration, and Modal/Koyeb deployment flows</li>
              <li>Debugged production deployment issues across API, runtime, catalog, and inference layers</li>
              <li>Added guardrails for billing safety, idempotency, rate limiting, and access control</li>
            </ul>
            <div class="timeline-tags">
              <span class="tag">TypeScript</span>
              <span class="tag">Fastify</span>
              <span class="tag">PostgreSQL</span>
              <span class="tag">Redis</span>
              <span class="tag">Docker</span>
              <span class="tag">BullMQ</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- ═══ PROJECTS ═══ -->
  <section class="section">
    <div class="container">
      <div data-reveal>
        <span class="section-label">02 — Projects</span>
        <h2 class="section-title">What I've Built.</h2>
      </div>

      <!-- Featured Project -->
      <div class="project-featured" data-reveal style="--stagger: 1">
        <ProjectArtwork artwork={featuredProject.artwork} title={featuredProject.title} wide />
        <div class="project-featured-body">
          <div class="project-featured-content">
            <div class="project-tags">
              {featuredProject.tags.map((tag, index) => (
                <span class:list={['tag', { 'tag--accent': index === 0 }]}>{tag}</span>
              ))}
            </div>
            <h3 class="project-title">{featuredProject.title}</h3>
            <p class="project-subtitle">{featuredProject.subtitle}</p>
            <ul class="project-details">
              {featuredProject.details.map((detail) => <li>{detail}</li>)}
            </ul>
          </div>
          <div class="project-featured-meta">
            <div class="meta-block">
              <span class="meta-label">Type</span>
              <span class="meta-value">{featuredProject.type}</span>
            </div>
            <div class="meta-block">
              <span class="meta-label">Status</span>
              <span class="meta-value"><span class="status-dot"></span> {featuredProject.status}</span>
            </div>
            <div class="project-actions">
              <a href={featuredProject.href} target="_blank" rel="noopener" class="project-link">GitHub -></a>
              <a href={featuredProject.liveHref} target="_blank" rel="noopener" class="project-link project-link--muted">Live -></a>
            </div>
          </div>
        </div>
      </div>

      <!-- Project Grid -->
      <div class="project-grid">
        {projects.map((project, index) => (
          <div class="project-card" data-reveal style={`--stagger: ${index + 2}`}>
            <ProjectArtwork artwork={project.artwork} title={project.title} />
            <div class="project-card-body">
              <div class="project-tags">
                {project.tags.map((tag, tagIndex) => (
                  <span class:list={['tag', { 'tag--cold': tagIndex === 0 }]}>{tag}</span>
                ))}
              </div>
              <h3 class="project-card-title">{project.title}</h3>
              <p class="project-card-desc">{project.description}</p>
              <div class="project-card-footer">
                <a href={project.href} target="_blank" rel="noopener" class="project-link">GitHub -></a>
                {'liveHref' in project && project.liveHref && (
                  <a href={project.liveHref} target="_blank" rel="noopener" class="project-link project-link--muted">Live -></a>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ═══ EDUCATION & ACTIVITIES ═══ -->
  <section class="section">
    <div class="container">
      <div class="edu-activities-grid">
        <div data-reveal>
          <span class="section-label">03 — Education</span>
          <div class="edu-block">
            <h3 class="edu-school">PES Modern College of Engineering</h3>
            <p class="edu-detail">Savitribai Phule Pune University</p>
            <p class="edu-degree">B.E. in Artificial Intelligence & Data Science</p>
            <span class="edu-date">Aug 2023 — Jun 2027 · Pune, India</span>
          </div>
        </div>

        <div data-reveal style="--stagger: 1">
          <span class="section-label">04 — Activities</span>
          <ul class="activities-list">
            <li>Organizer & contributor at Google Developer Group on Campus PES MCOE — hackathons and technical events</li>
            <li>Participated in AI and systems hackathons including MCCIA AI Hackathon 2026</li>
            <li>Build and maintain side projects across ML infrastructure, backend systems, Linux tooling, and web workflows</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

</Base>


<style>
  .page-header {
    padding-top: 120px;
  }

  .page-title {
    font-family: var(--font-display);
    font-size: clamp(42px, 8vw, 72px);
    font-weight: 400;
    font-style: italic;
    line-height: 1;
    color: var(--text-primary);
    margin: var(--space-6) 0 var(--space-6);
  }

  .page-subtitle {
    font-size: var(--text-body-lg);
    color: var(--text-tertiary);
    max-width: 520px;
  }

  /* Hero page-load animations */
  .hero-animate {
    opacity: 0;
    transform: translateY(24px);
    animation: hero-reveal 0.8s cubic-bezier(0.23, 1, 0.32, 1) forwards;
    animation-delay: calc(var(--delay) * 120ms + 100ms);
  }

  @keyframes hero-reveal {
    to { opacity: 1; transform: translateY(0); }
  }


  /* ─── TIMELINE ─── */
  .timeline-entry {
    display: grid;
    grid-template-columns: 200px 32px 1fr;
    gap: 0;
  }

  .timeline-date {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: 4px;
    text-align: right;
    padding-right: var(--space-4);
  }

  .date-range {
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    letter-spacing: var(--text-caption-ls);
    color: var(--text-tertiary);
  }

  .date-location {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--text-label-ls);
    text-transform: uppercase;
    color: var(--text-ghost);
  }

  .timeline-line {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
  }

  .timeline-line::after {
    content: '';
    position: absolute;
    top: 12px;
    bottom: 0;
    width: 1px;
    background: linear-gradient(to bottom, var(--accent-primary), var(--border-subtle), transparent);
  }

  .timeline-dot {
    width: 8px;
    height: 8px;
    background: var(--accent-primary);
    flex-shrink: 0;
    margin-top: 6px;
    border-radius: 50%;
    box-shadow: 0 0 0 4px rgba(196, 67, 43, 0.12);
  }

  .timeline-content {
    padding-left: var(--space-6);
    padding-bottom: var(--space-12);
  }

  .timeline-company {
    font-family: var(--font-display);
    font-size: var(--text-h4);
    font-weight: 400;
    color: var(--text-primary);
    margin-bottom: var(--space-1);
  }

  .timeline-role {
    font-family: var(--font-mono);
    font-size: var(--text-body-sm);
    color: var(--text-tertiary);
    margin-bottom: var(--space-5);
  }

  .timeline-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }

  .timeline-list li {
    position: relative;
    padding-left: var(--space-5);
    font-size: var(--text-body-sm);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .timeline-list li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--text-ghost);
  }

  .timeline-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }


  /* ─── FEATURED PROJECT ─── */
  .project-featured {
    display: flex;
    flex-direction: column;
    background: var(--surface-raised);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-card);
    overflow: hidden;
    margin-bottom: var(--space-6);
    transition: border-color 0.3s ease,
                transform 0.3s cubic-bezier(0.23, 1, 0.32, 1),
                box-shadow 0.3s ease;
  }

  .project-featured .mesh-cover {
    aspect-ratio: 21 / 7;
    border-radius: 0;
  }

  .project-featured :global(.project-art) {
    border-radius: 0;
  }

  .project-featured-body {
    display: grid;
    grid-template-columns: 1fr 240px;
    gap: var(--space-8);
    padding: var(--space-12);
  }

  .project-featured:hover {
    border-color: var(--border-strong);
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .project-title {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: 400;
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }

  .project-subtitle {
    font-family: var(--font-mono);
    font-size: var(--text-body-sm);
    color: var(--text-tertiary);
    margin-bottom: var(--space-5);
  }

  .project-details {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .project-details li {
    position: relative;
    padding-left: var(--space-5);
    font-size: var(--text-body-sm);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .project-details li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--text-ghost);
  }

  .project-featured-meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding-top: var(--space-2);
    border-left: 1px solid var(--border-subtle);
    padding-left: var(--space-6);
  }

  .meta-block {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .meta-label {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: var(--text-label-weight);
    letter-spacing: var(--text-label-ls);
    text-transform: uppercase;
    color: var(--text-ghost);
  }

  .meta-value {
    font-size: var(--text-body-sm);
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }


  /* ─── PROJECT GRID ─── */
  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .project-card {
    display: flex;
    flex-direction: column;
    background: var(--surface-raised);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-card);
    overflow: hidden;
    transition: border-color 0.3s ease, transform 0.3s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .project-card .mesh-cover {
    border-radius: 0;
  }

  .project-card :global(.project-art) {
    border-radius: 0;
  }

  .project-card-body {
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    flex: 1;
  }

  .project-card:hover {
    border-color: var(--border-strong);
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .project-card-title {
    font-family: var(--font-display);
    font-size: var(--text-h4);
    font-weight: 400;
    color: var(--text-primary);
    margin-bottom: var(--space-3);
  }

  .project-card-desc {
    font-size: var(--text-body-sm);
    color: var(--text-tertiary);
    line-height: 1.6;
  }

  .project-card-footer {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: auto;
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-subtle);
  }

  .project-link {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--text-label-ls);
    text-transform: uppercase;
    color: var(--accent-cold);
    text-decoration: none;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .project-link:hover { color: var(--accent-cold-hover); }

  .project-link--muted {
    color: var(--text-tertiary);
  }

  .project-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    padding-top: var(--space-2);
  }


  /* ─── EDUCATION & ACTIVITIES ─── */
  .edu-activities-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-16);
  }

  .edu-block {
    margin-top: var(--space-5);
  }

  .edu-school {
    font-family: var(--font-display);
    font-size: var(--text-h4);
    font-weight: 400;
    color: var(--text-primary);
    margin-bottom: var(--space-1);
  }

  .edu-detail {
    font-size: var(--text-body-sm);
    color: var(--text-tertiary);
    margin-bottom: var(--space-2);
  }

  .edu-degree {
    font-size: var(--text-body);
    color: var(--text-secondary);
    margin-bottom: var(--space-2);
  }

  .edu-date {
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    letter-spacing: var(--text-caption-ls);
    color: var(--text-ghost);
  }

  .activities-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-top: var(--space-5);
  }

  .activities-list li {
    position: relative;
    padding-left: var(--space-5);
    font-size: var(--text-body-sm);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .activities-list li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--text-ghost);
  }


  /* ─── RESPONSIVE ─── */
  @media (max-width: 768px) {
    .page-header { padding-top: 100px; }
    .timeline-entry { grid-template-columns: 1fr; gap: var(--space-3); }
    .timeline-date { text-align: left; padding-right: 0; }
    .timeline-line { display: none; }
    .timeline-content { padding-left: 0; }
    .project-featured .mesh-cover { aspect-ratio: 5 / 3; }
    .project-featured-body { grid-template-columns: 1fr; gap: var(--space-6); padding: var(--space-8); }
    .project-featured-meta { border-left: none; padding-left: 0; border-top: 1px solid var(--border-subtle); padding-top: var(--space-5); }
    .project-grid { grid-template-columns: 1fr; }
    .edu-activities-grid { grid-template-columns: 1fr; gap: var(--space-10); }
  }
</style>
