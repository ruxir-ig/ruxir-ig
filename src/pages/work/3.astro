---
import Base from '../../layouts/Base.astro';
import VariantNav from '../../components/VariantNav.astro';
import ProjectArtwork from '../../components/ProjectArtwork.astro';
import { featuredProject, projects } from '../../data/site';

const all = [featuredProject, ...projects];
// vary the aspect ratios for a masonry rhythm
const ratios = ['3/4', '4/3', '1/1', '4/5', '5/4', '3/4', '4/3', '1/1', '4/5'];
---

<Base title="Work · 3" class="w3" description="Project gallery — image-forward view.">
  <VariantNav kind="work" current="3" />

  <section class="w3">
    <div class="container w3__head">
      <span class="section-label">Gallery — /work</span>
      <h1 class="w3__title">Selected <i>Frames.</i></h1>
      <p class="w3__sub">Hover any frame for the story.</p>
    </div>

    <div class="container w3__masonry">
      {all.map((p, i) => (
        <a class="w3__tile" href={p.href} target="_blank" rel="noopener" data-reveal style={`--ratio:${ratios[i % ratios.length]};--stagger:${(i % 6) + 1}`}>
          <div class="w3__art" style={`aspect-ratio:${ratios[i % ratios.length]}`}>
            <ProjectArtwork artwork={p.artwork} title={p.title} />
          </div>
          <div class="w3__overlay">
            <div class="w3__otop">
              <span class="w3__onum">№ {String(i + 1).padStart(2, '0')}</span>
              {p.status && <span class="w3__ostat">{p.status}</span>}
            </div>
            <div class="w3__obottom">
              <div class="w3__otags">
                {p.tags.slice(0, 2).map((t, ti) => (
                  <span class:list={['tag', { 'tag--accent': i === 0 && ti === 0, 'tag--cold': i !== 0 && ti === 0 }]}>{t}</span>
                ))}
              </div>
              <h3 class="w3__otitle">{p.title}</h3>
              <p class="w3__odesc">{p.description}</p>
              <span class="w3__ogo">View ↗</span>
            </div>
          </div>
        </a>
      ))}
    </div>

    <div class="container w3__foot" data-reveal>
      <span>{all.length} works · ongoing</span>
      <a href="/journal" class="w3__cta">Journal →</a>
    </div>
  </section>
</Base>

<style>
  .w3 { padding: 128px 0 var(--space-16); }
  .w3__head { margin-bottom: var(--space-12); display: flex; flex-direction: column; gap: var(--space-3); }
  .w3__title { font-family: var(--font-display); font-weight: 400; font-size: clamp(44px, 8vw, 80px); line-height: 1; color: var(--text-primary); }
  .w3__title i { font-style: italic; color: var(--accent-amber); }
  .w3__sub { font-family: var(--font-mono); font-size: var(--text-caption); letter-spacing: var(--text-caption-ls); color: var(--text-ghost); }

  .w3__masonry {
    column-count: 3;
    column-gap: var(--space-4);
  }
  .w3__tile {
    position: relative;
    display: block;
    width: 100%;
    margin: 0 0 var(--space-4);
    break-inside: avoid;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border-default);
    text-decoration: none;
    transition: border-color var(--duration-base) var(--ease-out), transform var(--duration-slow) var(--ease-out);
  }
  .w3__tile:hover { border-color: var(--border-strong); transform: translateY(-3px); }

  .w3__art { width: 100%; }
  .w3__art :global(.project-art) { border-radius: 0; aspect-ratio: auto; height: 100%; }
  .w3__art :global(.project-art img) { transition: transform var(--duration-cinematic) var(--ease-out), filter var(--duration-cinematic) var(--ease-out); }

  .w3__overlay {
    position: absolute;
    inset: 0;
    z-index: 4;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--space-5);
    background: linear-gradient(to bottom, rgba(8,8,8,0.55) 0%, transparent 35%, rgba(8,8,8,0.85) 100%);
    opacity: 0;
    transition: opacity var(--duration-slow) var(--ease-out);
  }
  .w3__tile:hover .w3__overlay { opacity: 1; }
  .w3__otop { display: flex; justify-content: space-between; align-items: center; }
  .w3__onum { font-family: var(--font-mono); font-size: var(--text-label); letter-spacing: var(--text-label-ls); text-transform: uppercase; color: var(--text-primary); }
  .w3__ostat { font-family: var(--font-mono); font-size: var(--text-label); letter-spacing: var(--text-label-ls); text-transform: uppercase; color: var(--accent-sage); }
  .w3__obottom { display: flex; flex-direction: column; gap: var(--space-2); transform: translateY(12px); transition: transform var(--duration-slow) var(--ease-out); }
  .w3__tile:hover .w3__obottom { transform: translateY(0); }
  .w3__otags { display: flex; flex-wrap: wrap; gap: 6px; }
  .w3__otitle { font-family: var(--font-display); font-weight: 400; font-size: var(--text-h3); color: var(--text-primary); }
  .w3__odesc { font-size: var(--text-body-sm); color: var(--text-secondary); line-height: 1.5; max-width: 42ch; }
  .w3__ogo { font-family: var(--font-mono); font-size: var(--text-label); letter-spacing: var(--text-label-ls); text-transform: uppercase; color: var(--accent-cold); margin-top: var(--space-1); }

  .w3__foot { display: flex; justify-content: space-between; align-items: center; margin-top: var(--space-16); padding-top: var(--space-8); border-top: 1px solid var(--border-subtle); font-family: var(--font-mono); font-size: var(--text-caption); letter-spacing: var(--text-caption-ls); color: var(--text-ghost); }
  .w3__cta { color: var(--accent-cold); text-decoration: none; }
  .w3__cta:hover { color: var(--accent-cold-hover); }

  @media (max-width: 900px) { .w3__masonry { column-count: 2; } }
  @media (max-width: 560px) {
    .w3__masonry { column-count: 1; }
    .w3__art, .w3__art :global(.project-art) { aspect-ratio: 4/3 !important; }
    /* always show overlay text on touch */
    .w3__overlay { opacity: 1; background: linear-gradient(to bottom, transparent 50%, rgba(8,8,8,0.9) 100%); }
  }
</style>
