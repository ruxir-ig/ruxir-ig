---
import Base from '../../layouts/Base.astro';
import VariantNav from '../../components/VariantNav.astro';
import ProjectArtwork from '../../components/ProjectArtwork.astro';
import { featuredProject, projects, experience, education, activities } from '../../data/site';
---

<Base title="Work · 4" class="w4" description="Case study view — featured project, narrative.">
  <VariantNav kind="work" current="4" />

  <article class="w4">
    <!-- featured case study -->
    <header class="container w4__head" data-reveal>
      <span class="section-label">Case Study № 01</span>
      <h1 class="w4__title">{featuredProject.title}</h1>
      <p class="w4__sub">{featuredProject.subtitle}</p>
    </header>

    <div class="container w4__hero" data-reveal style="--stagger:1">
      <ProjectArtwork artwork={featuredProject.artwork} title={featuredProject.title} wide />
    </div>

    <div class="container w4__case">
      <aside class="w4__meta" data-reveal>
        <div class="w4__metarow"><span class="w4__ml">Type</span><span class="w4__mv">{featuredProject.type}</span></div>
        <div class="w4__metarow"><span class="w4__ml">Status</span><span class="w4__mv"><i class="w4__dot"></i> {featuredProject.status}</span></div>
        <div class="w4__metarow"><span class="w4__ml">Stack</span><span class="w4__mv">{featuredProject.tags.join(' · ')}</span></div>
        <div class="w4__actions">
          <a href={featuredProject.href} target="_blank" rel="noopener" class="w4__link">GitHub ↗</a>
          {featuredProject.liveHref && <a href={featuredProject.liveHref} target="_blank" rel="noopener" class="w4__link w4__link--muted">Live ↗</a>}
        </div>
      </aside>

      <div class="w4__prose" data-reveal style="--stagger:1">
        <p class="w4__lead">{featuredProject.details[0]}</p>
        {featuredProject.details.slice(1).map((d, i) => (
          <p class="w4__p">{d}</p>
        ))}
        <blockquote class="w4__bq">Built end-to-end across API, runtime, catalog, and inference layers — the kind of system where the small deployment details are the whole game.</blockquote>
        <div class="w4__tags">{featuredProject.tags.map((t, ti) => <span class:list={['tag', { 'tag--accent': ti === 0 }]}>{t}</span>)}</div>
      </div>
    </div>

    <!-- compact grid below -->
    <section class="container w4__more">
      <div class="w4__morehead" data-reveal>
        <span class="section-label">More work</span>
        <h2 class="w4__moretitle">Other <i>explorations.</i></h2>
      </div>

      <div class="w4__grid">
        {projects.map((p, i) => (
          <a class="w4__card" href={p.href} target="_blank" rel="noopener" data-reveal style={`--stagger:${(i % 6) + 1}`}>
            <div class="w4__cover"><ProjectArtwork artwork={p.artwork} title={p.title} /></div>
            <div class="w4__cardbody">
              <div class="w4__tags">
                {p.tags.slice(0, 2).map((t, ti) => <span class:list={['tag', { 'tag--cold': ti === 0 }]}>{t}</span>)}
              </div>
              <h3 class="w4__cardtitle">{p.title}</h3>
              <p class="w4__carddesc">{p.description}</p>
              <span class="w4__cardgo">{p.year} · GitHub ↗</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- career strip -->
    <section class="container w4__career">
      <div class="w4__careercol" data-reveal>
        <span class="section-label">Experience</span>
        <h3 class="w4__company">{experience.company}</h3>
        <p class="w4__role">{experience.role} · {experience.range}</p>
        <ul class="w4__bullets">{experience.bullets.map((b) => <li>{b}</li>)}</ul>
      </div>
      <div class="w4__careercol" data-reveal style="--stagger:1">
        <span class="section-label">Education & Activities</span>
        <p class="w4__school">{education.school}</p>
        <p class="w4__degree">{education.degree}</p>
        <p class="w4__edudate">{education.date}</p>
        <ul class="w4__acts">{activities.map((a) => <li>{a}</li>)}</ul>
      </div>
    </section>
  </article>
</Base>

<style>
  .w4 { padding: 128px 0 var(--space-16); }
  .w4__head { margin-bottom: var(--space-10); }
  .w4__title { font-family: var(--font-display); font-weight: 400; font-size: clamp(48px, 9vw, 96px); line-height: 0.98; letter-spacing: -0.03em; color: var(--text-primary); margin: var(--space-4) 0 var(--space-3); }
  .w4__sub { font-family: var(--font-display); font-style: italic; font-size: var(--text-h4); color: var(--text-tertiary); }
  .w4__hero { margin-bottom: var(--space-16); }
  .w4__hero :global(.project-art) { border-radius: var(--radius-lg); }

  .w4__case { display: grid; grid-template-columns: 240px 1fr; gap: var(--space-16); margin-bottom: var(--space-32); }
  .w4__meta { position: sticky; top: 100px; align-self: start; display: flex; flex-direction: column; gap: var(--space-5); padding-right: var(--space-6); border-right: 1px solid var(--border-subtle); }
  .w4__metarow { display: flex; flex-direction: column; gap: 4px; }
  .w4__ml { font-family: var(--font-mono); font-size: var(--text-label); letter-spacing: var(--text-label-ls); text-transform: uppercase; color: var(--text-ghost); }
  .w4__mv { font-size: var(--text-body-sm); color: var(--text-secondary); display: flex; align-items: center; gap: 8px; }
  .w4__dot { display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--accent-sage); }
  .w4__actions { display: flex; flex-direction: column; gap: var(--space-2); padding-top: var(--space-4); border-top: 1px solid var(--border-subtle); }
  .w4__link { font-family: var(--font-mono); font-size: var(--text-label); letter-spacing: var(--text-label-ls); text-transform: uppercase; color: var(--accent-cold); text-decoration: none; }
  .w4__link:hover { color: var(--accent-cold-hover); }
  .w4__link--muted { color: var(--text-tertiary); }

  .w4__prose { max-width: 680px; }
  .w4__lead { font-family: var(--font-display); font-weight: 400; font-size: clamp(24px, 3vw, 36px); line-height: 1.35; color: var(--text-primary); margin-bottom: var(--space-6); }
  .w4__p { font-size: var(--text-body-lg); line-height: 1.75; color: var(--text-secondary); margin-bottom: var(--space-5); }
  .w4__bq { border-left: 2px solid var(--accent-primary); padding-left: var(--space-6); margin: var(--space-8) 0; font-family: var(--font-display); font-style: italic; font-size: var(--text-h4); line-height: 1.4; color: var(--text-primary); }
  .w4__tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: var(--space-6); }

  .w4__morehead { margin-bottom: var(--space-10); }
  .w4__moretitle { font-family: var(--font-display); font-weight: 400; font-size: var(--text-h2); color: var(--text-primary); margin-top: var(--space-3); }
  .w4__moretitle i { font-style: italic; color: var(--accent-amber); }
  .w4__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4); margin-bottom: var(--space-32); }
  .w4__card { display: flex; flex-direction: column; background: var(--surface-raised); border: 1px solid var(--border-default); border-radius: var(--radius-lg); overflow: hidden; text-decoration: none; transition: border-color var(--duration-base) var(--ease-out), transform var(--duration-slow) var(--ease-out), box-shadow var(--duration-slow) var(--ease-out); }
  .w4__card:hover { border-color: var(--border-strong); transform: translateY(-4px); box-shadow: var(--shadow-lg); }
  .w4__cover :global(.project-art) { border-radius: 0; aspect-ratio: 16/10; }
  .w4__cardbody { padding: var(--space-5); display: flex; flex-direction: column; gap: var(--space-2); flex: 1; }
  .w4__tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .w4__cardtitle { font-family: var(--font-display); font-weight: 400; font-size: var(--text-h4); color: var(--text-primary); }
  .w4__carddesc { font-size: var(--text-body-sm); color: var(--text-tertiary); line-height: 1.6; flex: 1; }
  .w4__cardgo { font-family: var(--font-mono); font-size: var(--text-label); letter-spacing: var(--text-label-ls); text-transform: uppercase; color: var(--accent-cold); margin-top: var(--space-2); }

  .w4__career { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-16); padding-top: var(--space-16); border-top: 1px solid var(--border-subtle); }
  .w4__careercol { display: flex; flex-direction: column; gap: var(--space-2); }
  .w4__company { font-family: var(--font-display); font-weight: 400; font-size: var(--text-h4); color: var(--text-primary); margin-top: var(--space-3); }
  .w4__role { font-family: var(--font-mono); font-size: var(--text-body-sm); color: var(--text-tertiary); margin-bottom: var(--space-3); }
  .w4__bullets, .w4__acts { list-style: none; display: flex; flex-direction: column; gap: var(--space-2); }
  .w4__bullets li, .w4__acts li { position: relative; padding-left: var(--space-5); font-size: var(--text-body-sm); color: var(--text-secondary); line-height: 1.6; }
  .w4__bullets li::before, .w4__acts li::before { content: '—'; position: absolute; left: 0; color: var(--text-ghost); }
  .w4__school { font-family: var(--font-display); font-weight: 400; font-size: var(--text-h4); color: var(--text-primary); margin-top: var(--space-3); }
  .w4__degree { font-size: var(--text-body); color: var(--text-secondary); }
  .w4__edudate { font-family: var(--font-mono); font-size: var(--text-caption); letter-spacing: var(--text-caption-ls); color: var(--text-ghost); margin-bottom: var(--space-3); }

  @media (max-width: 900px) {
    .w4__case { grid-template-columns: 1fr; gap: var(--space-8); }
    .w4__meta { position: static; border-right: none; border-bottom: 1px solid var(--border-subtle); padding-right: 0; padding-bottom: var(--space-5); }
    .w4__grid { grid-template-columns: repeat(2, 1fr); }
    .w4__career { grid-template-columns: 1fr; gap: var(--space-10); }
  }
  @media (max-width: 560px) { .w4__grid { grid-template-columns: 1fr; } }
</style>
